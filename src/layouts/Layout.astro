        content="Je conçois des applications web cartographiques sur-mesure : SIG interactifs, dashboards et APIs géospatiales. Stack Angular, TypeScript, MapLibre. Disponible en Pyrénées-Orientales et remote." />
    <meta name="keywords"
        content="développeur full stack, développeur angular, développeur web, SIG, cartographie, MapLibre, Chart.js, TypeScript, RxJS, LoopBack, MongoDB, Studio 3T, Perpignan, Pyrénées-Orientales, Nanogis, freelance, CDI">
    <meta name="author" content="Mathieu">
    <meta name="robots" content="index, follow">
    <meta name="language" content="French">
    <meta name="revisit-after" content="7 days">

    <!-- Canonical URL -->
    <link rel="canonical" href="https://mathieuabbal.github.io/mat-dev/">

    <!-- Favicon -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg?v=3`} type="image/svg+xml">
    <link rel="alternate icon" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} type="image/png">
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon-32x32.png`}>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Font Awesome -->
    <script defer src="https://kit.fontawesome.com/ce2a36e089.js" crossorigin="anonymous"></script>

    <!-- Google Verification -->
    <meta name="google-site-verification" content="Yd2sd7XddExlO5ua0eaYPW4ImcbXOC8FQCfW3ntANBw" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mathieuabbal.github.io/mat-dev/" />
    <meta property="og:title" content="Mathieu | Développeur Full Stack Angular & SIG" />
    <meta property="og:description"
        content="Applications cartographiques sur-mesure, dashboards et APIs géospatiales. Stack Angular, TypeScript, MapLibre. Disponible en Pyrénées-Orientales et remote." />
    <meta property="og:image" content="https://mathieuabbal.github.io/mat-dev/img/image_site.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mathieu - Développeur Full Stack" />
    <meta property="og:site_name" content="Portfolio Mathieu" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="fb:app_id" content="361935935585848" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://mathieuabbal.github.io/mat-dev/" />
    <meta name="twitter:site" content="@Mathieu_dev_" />
    <meta name="twitter:creator" content="@Mathieu_dev_" />
    <meta name="twitter:title" content="Mathieu | Développeur Full Stack Angular & SIG" />
    <meta name="twitter:description"
        content="Applications cartographiques sur-mesure, dashboards et APIs géospatiales. Stack Angular, TypeScript, MapLibre." />
    <meta name="twitter:image" content="https://mathieuabbal.github.io/mat-dev/img/image_site.png" />

</head>

<body class="bg-[#f5f7fa] dark:bg-[#0a0e1a] font-sans text-gray-800 dark:text-gray-100 transition-colors duration-300">
    <!-- Background Halos - Mapbox palette -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
        <!-- Light mode halos -->
        <div class="dark:hidden absolute -top-32 -left-32 w-[600px] h-[600px] bg-[#4264fb]/10 blur-[150px] rounded-full"></div>
        <div class="dark:hidden absolute top-1/3 -right-32 w-[400px] h-[400px] bg-[#65d9fd]/15 blur-[130px] rounded-full"></div>
        <div class="dark:hidden absolute bottom-1/4 left-1/4 w-[500px] h-[500px] bg-[#4264fb]/8 blur-[140px] rounded-full"></div>
        <!-- Dark mode halos -->
        <div class="hidden dark:block absolute -top-32 -left-32 w-[600px] h-[600px] bg-[#4264fb]/12 blur-[150px] rounded-full"></div>
        <div class="hidden dark:block absolute top-1/3 -right-32 w-[400px] h-[400px] bg-[#65d9fd]/8 blur-[130px] rounded-full"></div>
        <div class="hidden dark:block absolute bottom-1/4 left-1/4 w-[500px] h-[500px] bg-[#4264fb]/6 blur-[140px] rounded-full"></div>
    </div>
    <!-- Skip to main content -->
    <a href="#about" class="skip-to-content">Aller au contenu</a>

    <slot />

    <!-- Scroll Reveal Observer -->
    <script>
        function initReveal() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

            document.querySelectorAll('.reveal, .stagger-children').forEach(el => {
                observer.observe(el);
            });
        }

        initReveal();
        document.addEventListener('astro:after-swap', initReveal);
    </script>

    <!-- Structured Data - Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Mathieu",
        "givenName": "Mathieu",
        "url": "https://mathieuabbal.github.io/mat-dev/",
        "image": "https://mathieuabbal.github.io/mat-dev/img/profil.jpg",
        "email": "mathieuabbal@hotmail.fr",
        "telephone": "+33617593521",
        "jobTitle": "Développeur Full Stack",
        "description": "Développeur Full Stack spécialisé en Angular, TypeScript et applications cartographiques SIG",
        "knowsAbout": ["Angular", "TypeScript", "RxJS", "MapLibre", "Chart.js", "LoopBack", "MongoDB", "JavaScript", "HTML", "CSS", "Node.js"],
        "worksFor": {
            "@type": "Organization",
            "name": "Nanogis",
            "description": "Logiciels cartographiques SIG"
        },
        "address": {
            "@type": "PostalAddress",
            "addressRegion": "Pyrénées-Orientales",
            "addressCountry": "France"
        },
        "sameAs": [
            "https://github.com/MathieuAbbal",
            "https://www.linkedin.com/in/mathieuabbal/",
