---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-400 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="flex space-x-4 mb-4 md:mb-0">
                <a href="https://github.com/MathieuAbbal" target="_blank"
                    class="hover:text-white transition-colors">
                    <i class="fab fa-github text-xl"></i>
                </a>
                <a href="https://www.linkedin.com/in/mathieu-abbal/" target="_blank"
                    class="hover:text-white transition-colors">
                    <i class="fab fa-linkedin text-xl"></i>
                </a>
                <a href="https://twitter.com/Mathieu_dev_" target="_blank"
                    class="hover:text-white transition-colors">
                    <i class="fab fa-twitter text-xl"></i>
                </a>
            </div>
            <p class="text-sm">
                &copy; {currentYear} Mathieu Abbal. Tous droits réservés.
            </p>
        </div>
