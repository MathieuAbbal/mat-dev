---
const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-gray-200 dark:border-slate-800/50 bg-white/50 dark:bg-[#0a0e1a]/80 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col items-center">
            <!-- Social Links -->
            <div class="flex gap-4 mb-8">
                <a href="https://github.com/MathieuAbbal" target="_blank" rel="noopener" aria-label="GitHub"
                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 dark:bg-slate-800/80 text-gray-500 dark:text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-110 hover:-translate-y-1 transition-all duration-300">
                    <i class="fab fa-github text-lg"></i>
                </a>
                <a href="https://www.linkedin.com/in/mathieuabbal/" target="_blank" rel="noopener" aria-label="LinkedIn"
                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 dark:bg-slate-800/80 text-gray-500 dark:text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-110 hover:-translate-y-1 transition-all duration-300">
                    <i class="fab fa-linkedin text-lg"></i>
                </a>
                <a href="https://twitter.com/Mathieu_dev_" target="_blank" rel="noopener" aria-label="Twitter"
                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 dark:bg-slate-800/80 text-gray-500 dark:text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-110 hover:-translate-y-1 transition-all duration-300">
                    <i class="fab fa-twitter text-lg"></i>
                </a>
            </div>

            <!-- Separator -->
            <div class="w-20 h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent mb-6"></div>

            <!-- Copyright -->
            <p class="text-sm text-gray-400 dark:text-slate-500">
                &copy; {currentYear} Mathieu. Tous droits réservés.
            </p>
        </div>
    </div>
</footer>
