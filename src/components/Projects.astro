---
import { PROJECTS } from "../constants/portfolio";

const illustrations: Record<string, string> = {
    sig: `<svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 h-20">
        <!-- Map base -->
        <rect x="10" y="8" width="100" height="64" rx="6" fill="white" fill-opacity="0.15" stroke="white" stroke-opacity="0.3" stroke-width="1.5"/>
        <!-- Grid lines -->
        <line x1="10" y1="28" x2="110" y2="28" stroke="white" stroke-opacity="0.1" stroke-width="1"/>
        <line x1="10" y1="48" x2="110" y2="48" stroke="white" stroke-opacity="0.1" stroke-width="1"/>
        <line x1="43" y1="8" x2="43" y2="72" stroke="white" stroke-opacity="0.1" stroke-width="1"/>
        <line x1="76" y1="8" x2="76" y2="72" stroke="white" stroke-opacity="0.1" stroke-width="1"/>
        <!-- Zone polygons -->
        <path d="M20 55 L35 35 L55 40 L50 60 Z" fill="white" fill-opacity="0.2" stroke="white" stroke-opacity="0.5" stroke-width="1.5"/>
        <path d="M60 20 L85 15 L95 35 L80 45 L60 38 Z" fill="white" fill-opacity="0.15" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <!-- Pin markers -->
        <circle cx="38" cy="42" r="4" fill="white" fill-opacity="0.9"/>
        <circle cx="38" cy="42" r="7" fill="none" stroke="white" stroke-opacity="0.4" stroke-width="1"/>
        <circle cx="75" cy="30" r="4" fill="white" fill-opacity="0.9"/>
        <circle cx="75" cy="30" r="7" fill="none" stroke="white" stroke-opacity="0.4" stroke-width="1"/>
        <circle cx="88" cy="55" r="3" fill="white" fill-opacity="0.7"/>
        <!-- Route line -->
        <path d="M38 42 Q55 25 75 30" stroke="white" stroke-opacity="0.6" stroke-width="1.5" stroke-dasharray="4 3" fill="none"/>
    </svg>`,

    dashboard: `<svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 h-20">
        <!-- Panel -->
        <rect x="10" y="8" width="100" height="64" rx="6" fill="white" fill-opacity="0.15" stroke="white" stroke-opacity="0.3" stroke-width="1.5"/>
        <!-- Bar chart -->
        <rect x="20" y="48" width="8" height="16" rx="2" fill="white" fill-opacity="0.5"/>
        <rect x="32" y="38" width="8" height="26" rx="2" fill="white" fill-opacity="0.7"/>
        <rect x="44" y="30" width="8" height="34" rx="2" fill="white" fill-opacity="0.9"/>
        <rect x="56" y="42" width="8" height="22" rx="2" fill="white" fill-opacity="0.6"/>
        <!-- Line chart -->
        <polyline points="72,50 82,35 92,42 102,22" stroke="white" stroke-opacity="0.8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <circle cx="72" cy="50" r="2.5" fill="white" fill-opacity="0.9"/>
        <circle cx="82" cy="35" r="2.5" fill="white" fill-opacity="0.9"/>
        <circle cx="92" cy="42" r="2.5" fill="white" fill-opacity="0.9"/>
        <circle cx="102" cy="22" r="2.5" fill="white" fill-opacity="0.9"/>
        <!-- KPI boxes -->
        <rect x="20" y="14" width="28" height="12" rx="3" fill="white" fill-opacity="0.2"/>
        <rect x="52" y="14" width="28" height="12" rx="3" fill="white" fill-opacity="0.2"/>
        <rect x="84" y="14" width="18" height="12" rx="3" fill="white" fill-opacity="0.2"/>
    </svg>`,

    api: `<svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 h-20">
        <!-- Server nodes -->
        <rect x="15" y="12" width="30" height="20" rx="4" fill="white" fill-opacity="0.2" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <circle cx="23" cy="22" r="2" fill="white" fill-opacity="0.7"/>
        <line x1="28" y1="22" x2="40" y2="22" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
        <rect x="75" y="12" width="30" height="20" rx="4" fill="white" fill-opacity="0.2" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <circle cx="83" cy="22" r="2" fill="white" fill-opacity="0.7"/>
        <line x1="88" y1="22" x2="100" y2="22" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
        <!-- Central hub -->
        <rect x="38" y="30" width="44" height="24" rx="6" fill="white" fill-opacity="0.25" stroke="white" stroke-opacity="0.5" stroke-width="1.5"/>
        <text x="60" y="46" text-anchor="middle" fill="white" fill-opacity="0.9" font-size="10" font-weight="bold" font-family="monospace">API</text>
        <!-- Connections -->
        <path d="M30 32 L48 36" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <path d="M90 32 L72 36" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <!-- Database -->
        <ellipse cx="60" cy="65" rx="16" ry="5" fill="white" fill-opacity="0.2" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <path d="M44 62 L44 65" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <path d="M76 62 L76 65" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <line x1="60" y1="54" x2="60" y2="60" stroke="white" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="3 2"/>
        <!-- Data dots -->
        <circle cx="25" cy="62" r="2" fill="white" fill-opacity="0.3"/>
        <circle cx="95" cy="62" r="2" fill="white" fill-opacity="0.3"/>
        <circle cx="25" cy="48" r="2" fill="white" fill-opacity="0.3"/>
        <circle cx="95" cy="48" r="2" fill="white" fill-opacity="0.3"/>
    </svg>`,

    geocrm: `<svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 h-20">
        <!-- Map background -->
        <rect x="10" y="8" width="65" height="64" rx="6" fill="white" fill-opacity="0.15" stroke="white" stroke-opacity="0.3" stroke-width="1.5"/>
        <!-- Map roads -->
        <path d="M15 40 L70 40" stroke="white" stroke-opacity="0.1" stroke-width="2"/>
        <path d="M40 12 L40 68" stroke="white" stroke-opacity="0.1" stroke-width="2"/>
        <!-- Client pins -->
        <circle cx="28" cy="25" r="4" fill="white" fill-opacity="0.9"/>
        <circle cx="28" cy="25" r="7" fill="none" stroke="white" stroke-opacity="0.3" stroke-width="1"/>
        <circle cx="55" cy="35" r="4" fill="white" fill-opacity="0.7"/>
        <circle cx="55" cy="35" r="7" fill="none" stroke="white" stroke-opacity="0.3" stroke-width="1"/>
        <circle cx="35" cy="55" r="3" fill="white" fill-opacity="0.6"/>
        <!-- CRM panel -->
        <rect x="80" y="8" width="32" height="64" rx="6" fill="white" fill-opacity="0.2" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
        <!-- User cards -->
        <circle cx="90" cy="22" r="4" fill="white" fill-opacity="0.5"/>
        <line x1="97" y1="20" x2="107" y2="20" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="97" y1="24" x2="104" y2="24" stroke="white" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round"/>
        <circle cx="90" cy="40" r="4" fill="white" fill-opacity="0.5"/>
        <line x1="97" y1="38" x2="107" y2="38" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="97" y1="42" x2="104" y2="42" stroke="white" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round"/>
        <circle cx="90" cy="58" r="4" fill="white" fill-opacity="0.5"/>
        <line x1="97" y1="56" x2="107" y2="56" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="97" y1="60" x2="104" y2="60" stroke="white" stroke-opacity="0.3" stroke-width="1" stroke-linecap="round"/>
        <!-- Connection lines -->
        <path d="M28 25 L86 22" stroke="white" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="3 3"/>
        <path d="M55 35 L86 40" stroke="white" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="3 3"/>
        <path d="M35 55 L86 58" stroke="white" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="3 3"/>
    </svg>`,

    supervisor: `<svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-28 h-20">
        <!-- Monitor frame -->
        <rect x="15" y="6" width="90" height="56" rx="6" fill="white" fill-opacity="0.15" stroke="white" stroke-opacity="0.3" stroke-width="1.5"/>
        <!-- Screen header bar -->
        <rect x="15" y="6" width="90" height="12" rx="6" fill="white" fill-opacity="0.1"/>
        <circle cx="24" cy="12" r="2" fill="#4ade80" fill-opacity="0.8"/>
        <circle cx="32" cy="12" r="2" fill="#facc15" fill-opacity="0.8"/>
        <circle cx="40" cy="12" r="2" fill="#f87171" fill-opacity="0.8"/>
        <!-- Log lines -->
        <rect x="22" y="24" width="35" height="3" rx="1" fill="#4ade80" fill-opacity="0.5"/>
        <rect x="22" y="30" width="28" height="3" rx="1" fill="#4ade80" fill-opacity="0.4"/>
        <rect x="22" y="36" width="40" height="3" rx="1" fill="#facc15" fill-opacity="0.5"/>
        <rect x="22" y="42" width="22" height="3" rx="1" fill="#f87171" fill-opacity="0.5"/>
        <rect x="22" y="48" width="32" height="3" rx="1" fill="#4ade80" fill-opacity="0.3"/>
        <!-- Side metrics -->
        <rect x="68" y="22" width="30" height="14" rx="3" fill="white" fill-opacity="0.1" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
        <rect x="68" y="40" width="30" height="14" rx="3" fill="white" fill-opacity="0.1" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
        <!-- Metric sparklines -->
        <polyline points="72,32 76,28 80,30 84,26 88,29 92,25" stroke="#4ade80" stroke-opacity="0.7" stroke-width="1.5" stroke-linecap="round" fill="none"/>
        <polyline points="72,50 76,48 80,52 84,46 88,50 92,44" stroke="#facc15" stroke-opacity="0.7" stroke-width="1.5" stroke-linecap="round" fill="none"/>
        <!-- Stand -->
        <rect x="50" y="62" width="20" height="3" rx="1" fill="white" fill-opacity="0.3"/>
        <rect x="45" y="65" width="30" height="3" rx="1.5" fill="white" fill-opacity="0.2"/>
        <!-- Shield icon -->
        <path d="M60 72 L56 74 L56 77 Q56 80 60 82 Q64 80 64 77 L64 74 Z" fill="white" fill-opacity="0.3" stroke="white" stroke-opacity="0.4" stroke-width="1"/>
    </svg>`,
};
---

<section id="projects" class="py-12 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 reveal">
            <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-3">Portfolio</p>
            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
                Projets
            </h2>
            <p class="text-gray-500 dark:text-slate-400 max-w-2xl mx-auto">
                Une sélection de projets professionnels chez Nanogis et projets personnels open source.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
            {PROJECTS.map((project) => {
                const Tag = project.link ? 'a' : 'div';
                const linkProps = project.link ? { href: project.link, target: '_blank', rel: 'noopener' } : {};
                return (
                    <Tag {...linkProps} class="group block bg-white dark:bg-[#111a2e]/60 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-lg overflow-hidden hover:border-indigo-400/50 dark:hover:border-indigo-500/50 hover:-translate-y-2 glow-hover transition-all duration-300">
                        <div class={`relative h-48 bg-gradient-to-br ${project.gradient} flex items-center justify-center overflow-hidden`}>
                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
                            <!-- Decorative circles -->
                            <div class="absolute -top-8 -right-8 w-24 h-24 bg-white/10 rounded-full"></div>
                            <div class="absolute -bottom-4 -left-4 w-16 h-16 bg-white/10 rounded-full"></div>
                            <div class="absolute top-4 left-4 w-8 h-8 bg-white/5 rounded-full"></div>
                            {project.link && (
                                <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                </div>
                            )}
                            <!-- Illustration -->
                            <div class="relative group-hover:scale-110 transition-transform duration-500" set:html={illustrations[project.icon] || ''} />
                        </div>
                        <div class="p-6">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{project.title}</h3>
                            <p class="text-gray-500 dark:text-slate-400 text-sm mb-4 leading-relaxed">
                                {project.description}
                            </p>
                            <div class="flex flex-wrap gap-2">
                                {project.tags.map((tag) => (
                                    <span class="px-3 py-1 border border-indigo-300/30 dark:border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/5 text-indigo-600 dark:text-indigo-300 rounded-full text-[11px] font-medium">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </Tag>
                );
            })}
        </div>
    </div>
</section>
