<button id="back2Top" aria-label="Retour en haut"
    class="group fixed right-6 bottom-6 w-12 h-12 flex items-center justify-center bg-gradient-to-br from-indigo-500 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd] text-white rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-xl hover:shadow-indigo-500/50 hover:-translate-y-1 hover:scale-110 active:scale-95 cursor-pointer opacity-0 invisible transition-all duration-300">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd"
            d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"
            clip-rule="evenodd" />
    </svg>
</button>

<script>
    const back2Top = document.getElementById('back2Top');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
            back2Top?.classList.remove('opacity-0', 'invisible');
            back2Top?.classList.add('opacity-100', 'visible');
        } else {
            back2Top?.classList.add('opacity-0', 'invisible');
            back2Top?.classList.remove('opacity-100', 'visible');
        }
    });
    back2Top?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>
