                    <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 dark:text-slate-500">Email</div>
                        <div class="text-sm font-medium text-gray-900 dark:text-white">mathieuabbal@hotmail.fr</div>
                    </div>
                </a>
                <a href="tel:+33617593521" class="group flex items-center gap-4 p-5 bg-white dark:bg-[#111a2e]/60 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-lg hover:border-indigo-400/50 dark:hover:border-indigo-500/50 glow-hover transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 dark:text-slate-500">Téléphone</div>
                        <div class="text-sm font-medium text-gray-900 dark:text-white">06 17 59 35 21</div>
                    </div>
                </a>
                <a href="https://www.linkedin.com/in/mathieuabbal/" target="_blank" class="group flex items-center gap-4 p-5 bg-white dark:bg-[#111a2e]/60 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-lg hover:border-indigo-400/50 dark:hover:border-indigo-500/50 glow-hover transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                        <i class="fab fa-linkedin-in text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 dark:text-slate-500">LinkedIn</div>
                        <div class="text-sm font-medium text-gray-900 dark:text-white">mathieuabbal</div>
                    </div>
                </a>
            </div>

            <!-- Native Contact Form -->
            <div class="dark relative bg-[linear-gradient(135deg,#0a0e1a_0%,#111a2e_50%,#050910_100%)] border border-white/10 rounded-lg p-5 sm:p-8 lg:p-10 overflow-hidden">
                <!-- Gradient glow -->
                <div class="absolute -top-20 -right-20 w-[300px] h-[300px] bg-[#4264fb]/25 blur-[100px] rounded-full pointer-events-none"></div>
                <div class="relative">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Envoyez-moi un message</h3>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-8">Tous les champs sont obligatoires.</p>

                <form id="contact-form" class="space-y-6" novalidate>
                    <div class="grid sm:grid-cols-2 gap-6">
                        <!-- Prénom -->
                        <div class="group">
                            <label for="prenom" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Prénom</label>
                            <input type="text" id="prenom" name="entry.1913821825" required
                                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 dark:focus:border-indigo-400 transition-all duration-200"
                                placeholder="Votre prénom" />
                        </div>
                        <!-- Nom -->
                        <div class="group">
                            <label for="nom" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Nom</label>
                            <input type="text" id="nom" name="entry.278515982" required
                                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 dark:focus:border-indigo-400 transition-all duration-200"
                                placeholder="Votre nom" />
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Adresse email</label>
                        <input type="email" id="email" name="entry.2061521444" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 dark:focus:border-indigo-400 transition-all duration-200"
                            placeholder="votre@email.com" />
                    </div>

                    <!-- Message -->
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Message</label>
                        <textarea id="message" name="entry.2063669290" rows="5" required
                            class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 dark:focus:border-indigo-400 transition-all duration-200 resize-none"
                            placeholder="Votre message..."></textarea>
                    </div>

                    <!-- Submit -->
                    <button type="submit" id="submit-btn"
                        class="btn-shimmer w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-700 hover:to-cyan-600 text-white font-semibold rounded-xl shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center justify-center gap-2">
                        <span id="btn-text">Envoyer le message</span>
                        <svg id="btn-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                        <svg id="btn-spinner" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                    </button>
                </form>

                <!-- Success message -->
                <div id="success-msg" class="hidden mt-6 p-5 rounded-xl bg-green-50 dark:bg-green-500/10 border border-green-200 dark:border-green-500/20">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        </div>
                        <div>
                            <p class="font-semibold text-green-800 dark:text-green-300">Message envoyé !</p>
                            <p class="text-sm text-green-600 dark:text-green-400">Merci, je vous répondrai dès que possible.</p>
                        </div>
                    </div>
                </div>

                <!-- Error message -->
                <div id="error-msg" class="hidden mt-6 p-5 rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-red-100 dark:bg-red-500/20 flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                        </div>
                        <div>
                            <p class="font-semibold text-red-800 dark:text-red-300">Erreur d'envoi</p>
                            <p class="text-sm text-red-600 dark:text-red-400">Veuillez réessayer ou me contacter directement par email.</p>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const btnSpinner = document.getElementById('btn-spinner');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Validate
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        // Loading state
        if (btnText) btnText.textContent = 'Envoi...';
        btnIcon?.classList.add('hidden');
        btnSpinner?.classList.remove('hidden');
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-75');
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');

        const formData = new FormData(form);
        const googleFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdygGSilXSkYrc1VRDYe-NXwhG6prdQxAL6EdWgRL21wtpLmw/formResponse';

        try {
            await fetch(googleFormUrl, {
                method: 'POST',
                body: formData,
                mode: 'no-cors',
            });

            // Success (no-cors always returns opaque response, so we assume success)
            form.reset();
            successMsg?.classList.remove('hidden');
            form.classList.add('hidden');
        } catch {
            errorMsg?.classList.remove('hidden');
        } finally {
            if (btnText) btnText.textContent = 'Envoyer le message';
            btnIcon?.classList.remove('hidden');
            btnSpinner?.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-75');
        }
    });
</script>
