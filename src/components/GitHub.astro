---
const username = 'MathieuAbbal';
---

<section id="github" class="dark relative py-12 sm:py-20 bg-gradient-to-br from-[#050910] via-[#0a1530] to-[#050910] text-gray-100 border-y border-white/5 overflow-hidden">
    <!-- Gradient glows -->
    <div class="absolute top-1/4 -right-40 w-[500px] h-[500px] bg-[#4264fb]/30 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 -left-40 w-[400px] h-[400px] bg-[#65d9fd]/20 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 reveal">
            <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-3">Open Source</p>
            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
                GitHub
            </h2>
            <p class="text-gray-500 dark:text-slate-400 max-w-2xl mx-auto">
                Mon activité open source et contributions.
            </p>
        </div>

        <!-- Contribution Graph -->
        <div class="mb-10 reveal">
            <div class="relative bg-white dark:bg-[#0d1117] backdrop-blur-sm border border-gray-200 dark:border-[#30363d] rounded-lg p-4 sm:p-6 overflow-x-auto">
                <div id="contrib-graph" class="flex justify-center">
                    <div class="flex gap-4">
                        <!-- Graph area -->
                        <div>
                            <div class="mb-2">
                                <span class="text-xs text-gray-400 dark:text-slate-500" id="contrib-total"></span>
                            </div>
                            <div class="flex gap-[2px]">
                                <!-- Day labels (Y axis) -->
                                <div class="flex flex-col gap-[2px] pr-1 text-[9px] text-gray-400 dark:text-slate-500 leading-[10px]">
                                    <span class="h-[10px]"></span>
                                    <span class="h-[10px] flex items-center">Lun</span>
                                    <span class="h-[10px]"></span>
                                    <span class="h-[10px] flex items-center">Mer</span>
                                    <span class="h-[10px]"></span>
                                    <span class="h-[10px] flex items-center">Ven</span>
                                    <span class="h-[10px]"></span>
                                </div>
                                <!-- Grid + Month labels -->
                                <div class="overflow-hidden">
                                    <div id="contrib-months" class="flex text-[9px] text-gray-400 dark:text-slate-500 mb-[2px] h-[12px]"></div>
                                    <div id="contrib-grid" class="flex gap-[2px]"></div>
                                </div>
                            </div>
                            <!-- Legend -->
                            <div class="flex items-center justify-end gap-1 text-[10px] text-gray-400 dark:text-slate-500 mt-2">
                                <span>Moins</span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-gray-100 dark:bg-[#2a2f3a]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#9be9a8] dark:bg-[#0e4429]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#40c463] dark:bg-[#006d32]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#30a14e] dark:bg-[#26a641]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#216e39] dark:bg-[#39d353]"></span>
                                <span>Plus</span>
                            </div>
                        </div>
                        <!-- Year selector (column, right side) -->
                        <div class="flex flex-col gap-1 pl-3 border-l border-gray-200 dark:border-slate-700/50" id="year-selector"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contributions to (orgs) -->
        <div class="flex flex-wrap justify-center gap-3 mb-10 reveal">
            <a href="https://github.com/nanogis" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/nanogis.png" alt="nanogis" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@nanogis</span>
            </a>
            <a href="https://github.com/angular" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/angular.png" alt="angular" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@angular</span>
            </a>
            <a href="https://github.com/maplibre" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/maplibre.png" alt="maplibre" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@maplibre</span>
            </a>
            <a href="https://github.com/betagouv" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/betagouv.png" alt="betagouv" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@betagouv</span>
            </a>
        </div>

        <!-- Merged PRs (dynamic) -->
        <div class="mb-10 reveal">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-slate-300 mb-4 flex items-center">
                <span class="w-10 h-0.5 bg-gradient-to-r from-indigo-500 to-cyan-500 mr-3 rounded-full"></span>
                Pull Requests mergées
            </h3>
            <div id="prs-container" class="flex flex-wrap gap-2">
                <span class="text-xs text-gray-400 dark:text-slate-500">Chargement...</span>
            </div>
        </div>

        <!-- Stats + Languages (dynamic) -->
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-10 stagger-children">
            <!-- Top Languages (dynamic) -->
            <div class="bg-white dark:bg-[#111a2e]/60 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-lg p-6 hover:border-indigo-400/50 dark:hover:border-indigo-500/50 glow-hover transition-all duration-300">
                <h3 class="text-sm font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-5 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    Langages principaux
                </h3>
                <div id="langs-container" class="space-y-4">
                    <span class="text-xs text-gray-400 dark:text-slate-500">Chargement...</span>
                </div>
            </div>

            <!-- Stats (dynamic) -->
            <div class="bg-white dark:bg-[#111a2e]/60 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-lg p-6 hover:border-indigo-400/50 dark:hover:border-indigo-500/50 glow-hover transition-all duration-300">
                <h3 class="text-sm font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-5 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    Activité
                </h3>
                <div id="stats-container" class="grid grid-cols-2 gap-4">
                    <span class="text-xs text-gray-400 dark:text-slate-500 col-span-2">Chargement...</span>
                </div>
            </div>
        </div>

        <!-- Repos (dynamic) -->
        <div class="reveal">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-slate-300 mb-6 flex items-center">
                <span class="w-10 h-0.5 bg-gradient-to-r from-indigo-500 to-cyan-500 mr-3 rounded-full"></span>
                Repos publics
            </h3>
            <div id="repos-container" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <span class="text-xs text-gray-400 dark:text-slate-500">Chargement...</span>
            </div>
        </div>

        <!-- Profile Link -->
        <div class="text-center mt-10 reveal">
            <a href={`https://github.com/${username}`} target="_blank"
                class="btn-shimmer inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white/10 text-white rounded-xl hover:bg-gray-800 dark:hover:bg-white/20 hover:-translate-y-0.5 transition-all duration-200 font-medium">
                <i class="fab fa-github text-lg"></i>
                Voir mon profil GitHub
            </a>
        </div>
    </div>
</section>

<script>
    const USERNAME = 'MathieuAbbal';
    const GH_API = 'https://api.github.com';
    const LANG_COLORS: Record<string, string> = {
        TypeScript: '#3178C6', JavaScript: '#f1e05a', HTML: '#e34c26',
        CSS: '#563d7c', SCSS: '#c6538c', Astro: '#FF5D01', MDX: '#fcb32c',
        Python: '#3572A5', Shell: '#89e051', Vue: '#41b883',
    };

    // --- Contribution graph ---
    const LIGHT_COLORS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
    const DARK_COLORS = ['#2a2f3a', '#0e4429', '#006d32', '#26a641', '#39d353'];
    const MONTHS = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'];
    const DAYS = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];

    const currentYear = new Date().getFullYear();
    const START_YEAR = 2020;
    let selectedYear = 'last';

    function buildYearSelector() {
        const container = document.getElementById('year-selector');
        if (!container) return;
        container.innerHTML = '';
        for (let y = currentYear; y >= START_YEAR; y--) {
            const year = String(y);
            const btn = document.createElement('button');
            btn.textContent = year;
            const isActive = selectedYear === year || (selectedYear === 'last' && year === String(currentYear));
            btn.className = isActive
                ? 'px-2 py-0.5 text-[10px] font-semibold rounded-md bg-indigo-600 text-white'
                : 'px-2 py-0.5 text-[10px] font-medium rounded-md text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors';
            btn.addEventListener('click', () => { selectedYear = year; loadContribGraph(year); buildYearSelector(); });
            container.appendChild(btn);
        }
    }

    async function loadContribGraph(year: string = 'last') {
        const grid = document.getElementById('contrib-grid');
        const totalEl = document.getElementById('contrib-total');
        if (!grid) return;

        try {
            const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${USERNAME}?y=${year}`);
            const data = await res.json();
            const contributions = data.contributions;
            const totalKey = year === 'last' ? 'lastYear' : year;
            const total = data.total[totalKey] || data.total.lastYear || 0;
            if (totalEl) totalEl.textContent = `${total} contributions${year === 'last' ? ' cette année' : ` en ${year}`}`;

            const weeks: { date: string; count: number; level: number }[][] = [];
            let currentWeek: { date: string; count: number; level: number }[] = [];
            const firstDay = new Date(contributions[0].date).getDay();
            for (let i = 0; i < firstDay; i++) currentWeek.push({ date: '', count: -1, level: -1 });
            contributions.forEach((day: { date: string; count: number; level: number }) => {
                currentWeek.push(day);
                if (currentWeek.length === 7) { weeks.push(currentWeek); currentWeek = []; }
            });
            if (currentWeek.length > 0) weeks.push(currentWeek);

            const isDark = (document.getElementById('github')?.classList.contains('dark') ?? false);
            const colors = isDark ? DARK_COLORS : LIGHT_COLORS;

            const monthsEl = document.getElementById('contrib-months');
            if (monthsEl) {
                monthsEl.innerHTML = '';
                let lastMonth = -1;
                let lastLabelX = -50;
                weeks.forEach((week, i) => {
                    const fd = week.find(d => d.level !== -1);
                    if (fd) {
                        const m = new Date(fd.date).getMonth();
                        const x = i * 12;
                        if (m !== lastMonth && x - lastLabelX >= 30) {
                            const span = document.createElement('span');
                            span.textContent = MONTHS[m];
                            span.style.position = 'absolute';
                            span.style.left = `${x}px`;
                            monthsEl.appendChild(span);
                            lastMonth = m;
                            lastLabelX = x;
                        }
                    }
                });
                monthsEl.style.position = 'relative';
            }

            grid.innerHTML = '';
            weeks.forEach(week => {
                const col = document.createElement('div');
                col.className = 'flex flex-col gap-[2px]';
                week.forEach(day => {
                    const cell = document.createElement('div');
                    cell.className = 'w-[10px] h-[10px] rounded-[2px] cursor-pointer';
                    if (day.level === -1) {
                        cell.style.background = 'transparent';
                    } else {
                        cell.style.background = colors[day.level];
                        cell.dataset.date = day.date;
                        cell.dataset.count = String(day.count);
                        const d = new Date(day.date);
                        const label = day.count === 0 ? 'Aucune contribution' : `${day.count} contribution${day.count > 1 ? 's' : ''}`;
                        cell.title = `${label} le ${DAYS[d.getDay()]} ${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
                    }
                    col.appendChild(cell);
                });
                grid.appendChild(col);
            });
        } catch {
            grid.innerHTML = '<p class="text-sm text-gray-400">Impossible de charger les contributions.</p>';
        }
    }


    // --- Dynamic stats, langs, repos, PRs ---
    async function loadGitHubData() {
        try {
            const [userRes, reposRes, prsRes] = await Promise.all([
                fetch(`${GH_API}/users/${USERNAME}`),
                fetch(`${GH_API}/users/${USERNAME}/repos?per_page=100&sort=updated`),
                fetch(`${GH_API}/search/issues?q=author:${USERNAME}+type:pr+is:merged&per_page=20&sort=updated`),
            ]);

            const user = await userRes.json();
            const repos = await reposRes.json();
            const prsData = await prsRes.json();

            // --- Stats ---
            const statsEl = document.getElementById('stats-container');
            if (statsEl) {
                const since = new Date(user.created_at).getFullYear();
                const yearsOnGh = currentYear - since;
                const statCard = (value: string, label: string) =>
                    `<div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 text-center">
                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500" style="-webkit-background-clip:text">${value}</div>
                        <div class="text-xs text-gray-500 dark:text-slate-400 mt-1">${label}</div>
                    </div>`;
                statsEl.innerHTML =
                    statCard(String(user.public_repos), 'Repos publics') +
                    statCard(`${yearsOnGh} ans`, 'Sur GitHub') +
                    statCard(String(prsData.total_count || 0), 'PRs mergées') +
                    statCard(String(user.following), 'Following');
            }

            // --- Languages ---
            const langsEl = document.getElementById('langs-container');
            if (langsEl && Array.isArray(repos)) {
                const langCount: Record<string, number> = {};
                repos.forEach((r: any) => {
                    if (r.language) langCount[r.language] = (langCount[r.language] || 0) + 1;
                });
                const total = Object.values(langCount).reduce((a, b) => a + b, 0);
                const sorted = Object.entries(langCount).sort((a, b) => b[1] - a[1]).slice(0, 6);

                langsEl.innerHTML = sorted.map(([lang, count], i) => {
                    const pct = Math.round((count / total) * 100);
                    const color = LANG_COLORS[lang] || '#6c7086';
                    return `<div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700 dark:text-slate-300">${lang}</span>
                            <span class="text-gray-500 dark:text-slate-400 lang-percent" data-target="${pct}">0%</span>
                        </div>
                        <div class="h-2 bg-gray-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="lang-bar h-full rounded-full" data-target="${pct}" style="width:0%;background:${color};transition:width 1.2s cubic-bezier(0.16,1,0.3,1) ${i * 0.1}s"></div>
                        </div>
                    </div>`;
                }).join('');

                // Animate when visible
                const animateBars = () => {
                    document.querySelectorAll<HTMLElement>('.lang-bar').forEach(bar => {
                        bar.style.width = `${bar.dataset.target}%`;
                    });
                    document.querySelectorAll<HTMLElement>('.lang-percent').forEach((el, i) => {
                        const target = parseInt(el.dataset.target || '0');
                        const duration = 1200;
                        const delay = i * 100;
                        const start = performance.now() + delay;
                        const animate = (now: number) => {
                            if (now < start) { requestAnimationFrame(animate); return; }
                            const t = Math.min((now - start) / duration, 1);
                            const eased = 1 - Math.pow(1 - t, 3);
                            el.textContent = `${Math.round(target * eased)}%`;
                            if (t < 1) requestAnimationFrame(animate);
                        };
                        requestAnimationFrame(animate);
                    });
                };

                if (langsEl) {
                    const langObs = new IntersectionObserver((entries) => {
                        if (!entries[0].isIntersecting) return;
                        langObs.disconnect();
                        animateBars();
                    }, { threshold: 0.3 });
                    langObs.observe(langsEl);
                }
            }

            // --- Repos ---
            const reposEl = document.getElementById('repos-container');
            if (reposEl && Array.isArray(repos)) {
                const filtered = repos
                    .filter((r: any) => !r.fork && r.name !== USERNAME)
                    .slice(0, 8);

                reposEl.innerHTML = filtered.map((r: any) => {
                    const color = LANG_COLORS[r.language] || '#6c7086';
                    const desc = r.description || 'Pas de description';
                    return `<a href="${r.html_url}" target="_blank"
                        class="group p-4 bg-white dark:bg-[#111a2e]/60 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-lg hover:border-indigo-400/50 dark:hover:border-indigo-500/50 hover:-translate-y-1 glow-hover transition-all duration-300">
                        <div class="flex items-start gap-3 mb-2">
                            <svg class="w-5 h-5 text-gray-400 dark:text-slate-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
                            <span class="font-semibold text-sm text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">${r.name}</span>
                        </div>
                        <p class="text-xs text-gray-500 dark:text-slate-400 mb-3 line-clamp-2">${desc}</p>
                        <div class="flex items-center gap-1.5">
                            ${r.language ? `<span class="w-3 h-3 rounded-full flex-shrink-0" style="background:${color}"></span><span class="text-xs text-gray-500 dark:text-slate-400">${r.language}</span>` : ''}
                        </div>
                    </a>`;
                }).join('');
            }

            // --- PRs ---
            const prsEl = document.getElementById('prs-container');
            if (prsEl && prsData.items) {
                const merged = prsData.items.filter((pr: any) => pr.pull_request?.merged_at);
                if (merged.length === 0) {
                    prsEl.innerHTML = '<span class="text-xs text-gray-400">Aucune PR mergée trouvée.</span>';
                } else {
                    prsEl.innerHTML = merged.map((pr: any) => {
                        const repoName = pr.repository_url.replace(`${GH_API}/repos/`, '');
                        return `<a href="${pr.html_url}" target="_blank"
                            class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-50 dark:bg-green-500/10 border border-green-200 dark:border-green-500/20 rounded-full hover:border-green-400 dark:hover:border-green-400/40 hover:bg-green-100 dark:hover:bg-green-500/15 transition-all group">
                            <svg class="w-3.5 h-3.5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                            <span class="text-xs font-medium text-green-700 dark:text-green-300">${repoName}</span>
                            <span class="text-xs text-green-600/70 dark:text-green-400/60 hidden sm:inline">— ${pr.title.substring(0, 50)}${pr.title.length > 50 ? '...' : ''}</span>
                        </a>`;
                    }).join('');
                }
            }
        } catch {
            // Fallback silencieux
        }
    }


    // Load when section is visible
    const ghSection = document.getElementById('github');
    if (ghSection) {
        const obs = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                obs.disconnect();
                buildYearSelector();
                loadContribGraph();
                loadGitHubData();
            }
        }, { rootMargin: '200px' });
        obs.observe(ghSection);
    }
</script>
