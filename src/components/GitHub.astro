---
const username = 'MathieuAbbal';

const mergedPRs = [
    { repo: 'angular/components', title: 'fix typo in aria-accessible-name comment', number: 32703 },
    { repo: 'angular/components', title: 'fix typo in drawer comment', number: 32702 },
    { repo: 'maplibre/maplibre.github.io', title: 'correct typos in MLT release post', number: 531 },
    { repo: 'maplibre/maplibre.github.io', title: 'correct typo in .gitignore', number: 527 },
];

const repos = [
    { name: 'mat-dev', desc: 'Portfolio personnel', lang: 'Astro', color: '#FF5D01' },
    { name: 'HubEau', desc: 'Application cartographique interactive hydrologique', lang: 'TypeScript', color: '#3178C6' },
    { name: 'strava-dashboard', desc: 'Dashboard activités sportives', lang: 'TypeScript', color: '#3178C6' },
    { name: 'components', desc: 'Infrastructure de composants Material Design', lang: 'TypeScript', color: '#3178C6' },
    { name: 'Family_app', desc: 'Application familiale', lang: 'TypeScript', color: '#3178C6' },
    { name: 'sport-et-nature', desc: 'Site sport et nature', lang: 'HTML', color: '#e34c26' },
    { name: 'site_de_sophie', desc: 'Site vitrine Infirmière Libérale', lang: 'TypeScript', color: '#3178C6' },
    { name: 'my-blog', desc: 'Blog personnel', lang: 'TypeScript', color: '#3178C6' },
];
---

<section id="github" class="py-12 sm:py-20 bg-white/60 dark:bg-white/[0.02] border-y border-indigo-100/40 dark:border-white/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 reveal">
            <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-3">Open Source</p>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4">
                GitHub
            </h2>
            <p class="text-gray-500 dark:text-slate-400 max-w-2xl mx-auto">
                Mon activité open source et contributions.
            </p>
        </div>

        <!-- Contribution Graph -->
        <div class="mb-10 reveal">
            <div class="relative bg-white dark:bg-[#0f172a]/50 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-2xl p-4 sm:p-6 overflow-x-auto">
                <div id="contrib-graph" class="min-w-[680px]">
                    <div class="flex gap-4">
                        <!-- Graph area -->
                        <div class="flex-1 min-w-0">
                            <div class="mb-2">
                                <span class="text-xs text-gray-400 dark:text-slate-500" id="contrib-total"></span>
                            </div>
                            <div class="flex gap-[2px]">
                                <!-- Day labels (Y axis) -->
                                <div class="flex flex-col gap-[2px] pr-1 text-[9px] text-gray-400 dark:text-slate-500 leading-[10px]">
                                    <span class="h-[10px]"></span>
                                    <span class="h-[10px] flex items-center">Lun</span>
                                    <span class="h-[10px]"></span>
                                    <span class="h-[10px] flex items-center">Mer</span>
                                    <span class="h-[10px]"></span>
                                    <span class="h-[10px] flex items-center">Ven</span>
                                    <span class="h-[10px]"></span>
                                </div>
                                <!-- Grid + Month labels -->
                                <div class="flex-1 overflow-hidden">
                                    <div id="contrib-months" class="flex text-[9px] text-gray-400 dark:text-slate-500 mb-[2px] h-[12px]"></div>
                                    <div id="contrib-grid" class="flex gap-[2px]"></div>
                                </div>
                            </div>
                            <!-- Legend -->
                            <div class="flex items-center justify-end gap-1 text-[10px] text-gray-400 dark:text-slate-500 mt-2">
                                <span>Moins</span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-gray-100 dark:bg-[#161b22]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#9be9a8] dark:bg-[#0e4429]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#40c463] dark:bg-[#006d32]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#30a14e] dark:bg-[#26a641]"></span>
                                <span class="w-[10px] h-[10px] rounded-[2px] bg-[#216e39] dark:bg-[#39d353]"></span>
                                <span>Plus</span>
                            </div>
                        </div>
                        <!-- Year selector (column, right side) -->
                        <div class="flex flex-col gap-1 pl-3 border-l border-gray-200 dark:border-slate-700/50" id="year-selector"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contributions to -->
        <div class="flex flex-wrap justify-center gap-3 mb-10 reveal">
            <a href="https://github.com/nanogis" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/nanogis.png" alt="nanogis" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@nanogis</span>
            </a>
            <a href="https://github.com/angular" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/angular.png" alt="angular" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@angular</span>
            </a>
            <a href="https://github.com/maplibre" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/maplibre.png" alt="maplibre" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@maplibre</span>
            </a>
            <a href="https://github.com/betagouv" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/50 rounded-full hover:border-indigo-400/50 transition-all text-sm group">
                <img src="https://github.com/betagouv.png" alt="betagouv" class="w-5 h-5 rounded-md" loading="lazy" />
                <span class="text-gray-700 dark:text-slate-300 font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@betagouv</span>
            </a>
        </div>

        <!-- Merged PRs -->
        <div class="mb-10 reveal">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-slate-300 mb-4 flex items-center">
                <span class="w-10 h-0.5 bg-gradient-to-r from-indigo-500 to-cyan-500 mr-3 rounded-full"></span>
                Pull Requests mergées
            </h3>
            <div class="flex flex-wrap gap-2">
                {mergedPRs.map((pr) => (
                    <a href={`https://github.com/${pr.repo}/pull/${pr.number}`} target="_blank"
                        class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-50 dark:bg-green-500/10 border border-green-200 dark:border-green-500/20 rounded-full hover:border-green-400 dark:hover:border-green-400/40 hover:bg-green-100 dark:hover:bg-green-500/15 transition-all group">
                        <svg class="w-3.5 h-3.5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                        <span class="text-xs font-medium text-green-700 dark:text-green-300">{pr.repo.split('/')[0]}/{pr.repo.split('/')[1]}</span>
                        <span class="text-xs text-green-600/70 dark:text-green-400/60 hidden sm:inline">— {pr.title}</span>
                    </a>
                ))}
            </div>
        </div>

        <!-- Stats + Languages -->
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-10 stagger-children">
            <!-- Top Languages -->
            <div class="bg-white dark:bg-[#0f172a]/50 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-2xl p-6 hover:border-indigo-400/50 dark:hover:border-indigo-500/50 glow-hover transition-all duration-300">
                <h3 class="text-sm font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-5 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    Langages principaux
                </h3>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700 dark:text-slate-300">TypeScript</span>
                            <span class="text-gray-500 dark:text-slate-400">42%</span>
                        </div>
                        <div class="h-2 bg-gray-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-[#3178C6] rounded-full" style="width: 42%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700 dark:text-slate-300">JavaScript</span>
                            <span class="text-gray-500 dark:text-slate-400">22%</span>
                        </div>
                        <div class="h-2 bg-gray-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-[#f1e05a] rounded-full" style="width: 22%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700 dark:text-slate-300">HTML</span>
                            <span class="text-gray-500 dark:text-slate-400">18%</span>
                        </div>
                        <div class="h-2 bg-gray-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-[#e34c26] rounded-full" style="width: 18%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700 dark:text-slate-300">CSS</span>
                            <span class="text-gray-500 dark:text-slate-400">12%</span>
                        </div>
                        <div class="h-2 bg-gray-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-[#563d7c] rounded-full" style="width: 12%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700 dark:text-slate-300">SCSS</span>
                            <span class="text-gray-500 dark:text-slate-400">6%</span>
                        </div>
                        <div class="h-2 bg-gray-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-[#c6538c] rounded-full" style="width: 6%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="bg-white dark:bg-[#0f172a]/50 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-2xl p-6 hover:border-indigo-400/50 dark:hover:border-indigo-500/50 glow-hover transition-all duration-300">
                <h3 class="text-sm font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-5 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    Activité
                </h3>
                <div class="grid grid-cols-2 gap-4">
                    <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 text-center">
                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#818cf8] dark:to-[#22d3ee]">1 881</div>
                        <div class="text-xs text-gray-500 dark:text-slate-400 mt-1">Contributions</div>
                    </div>
                    <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 text-center">
                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#818cf8] dark:to-[#22d3ee]">21+</div>
                        <div class="text-xs text-gray-500 dark:text-slate-400 mt-1">Repos publics</div>
                    </div>
                    <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 text-center">
                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#818cf8] dark:to-[#22d3ee]">39j</div>
                        <div class="text-xs text-gray-500 dark:text-slate-400 mt-1">Meilleur streak</div>
                    </div>
                    <div class="p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 text-center">
                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#818cf8] dark:to-[#22d3ee]">5 ans</div>
                        <div class="text-xs text-gray-500 dark:text-slate-400 mt-1">Sur GitHub</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Repos -->
        <div class="reveal">
            <h3 class="text-lg font-semibold text-gray-700 dark:text-slate-300 mb-6 flex items-center">
                <span class="w-10 h-0.5 bg-gradient-to-r from-indigo-500 to-cyan-500 mr-3 rounded-full"></span>
                Repos publics
            </h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 stagger-children">
                {repos.map((repo) => (
                    <a href={`https://github.com/${username}/${repo.name}`} target="_blank"
                        class="group p-4 bg-white dark:bg-[#0f172a]/50 backdrop-blur-sm border border-gray-200 dark:border-slate-800/50 rounded-2xl hover:border-indigo-400/50 dark:hover:border-indigo-500/50 hover:-translate-y-1 glow-hover transition-all duration-300">
                        <div class="flex items-start gap-3 mb-2">
                            <svg class="w-5 h-5 text-gray-400 dark:text-slate-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
                            <span class="font-semibold text-sm text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">{repo.name}</span>
                        </div>
                        <p class="text-xs text-gray-500 dark:text-slate-400 mb-3 line-clamp-2">{repo.desc}</p>
                        <div class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background: ${repo.color}`}></span>
                            <span class="text-xs text-gray-500 dark:text-slate-400">{repo.lang}</span>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- Profile Link -->
        <div class="text-center mt-10 reveal">
            <a href={`https://github.com/${username}`} target="_blank"
                class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white/10 text-white rounded-xl hover:bg-gray-800 dark:hover:bg-white/20 hover:-translate-y-0.5 transition-all duration-200 font-medium">
                <i class="fab fa-github text-lg"></i>
                Voir mon profil GitHub
            </a>
        </div>
    </div>
</section>

<!-- GitHub tooltip (must be outside section to avoid overflow clipping) -->
<div id="contrib-tooltip" class="fixed z-[200] hidden pointer-events-none">
    <div class="px-3 py-2 text-xs font-semibold text-white bg-[#24292f] rounded-md shadow-lg whitespace-nowrap">
        <span id="contrib-tooltip-text"></span>
    </div>
    <div class="flex justify-center -mt-1">
        <div class="w-2 h-2 bg-[#24292f] rotate-45"></div>
    </div>
</div>

<script>
    const LIGHT_COLORS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
    const DARK_COLORS = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
    const MONTHS = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'];
    const DAYS = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];

    const currentYear = new Date().getFullYear();
    const START_YEAR = 2020;
    let selectedYear = 'last';

    function buildYearSelector() {
        const container = document.getElementById('year-selector');
        if (!container) return;
        container.innerHTML = '';

        const years: string[] = [];
        for (let y = currentYear; y >= START_YEAR; y--) {
            years.push(String(y));
        }

        years.forEach(year => {
            const btn = document.createElement('button');
            btn.textContent = year;
            btn.dataset.year = year;
            const isActive = selectedYear === year || (selectedYear === 'last' && year === String(currentYear));
            btn.className = isActive
                ? 'px-2 py-0.5 text-[10px] font-semibold rounded-md bg-indigo-600 text-white'
                : 'px-2 py-0.5 text-[10px] font-medium rounded-md text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors';
            btn.addEventListener('click', () => {
                selectedYear = year;
                loadContribGraph(year);
                buildYearSelector();
            });
            container.appendChild(btn);
        });
    }

    async function loadContribGraph(year: string = 'last') {
        const grid = document.getElementById('contrib-grid');
        const totalEl = document.getElementById('contrib-total');
        const tooltip = document.getElementById('contrib-tooltip');
        if (!grid) return;

        try {
            const res = await fetch(`https://github-contributions-api.jogruber.de/v4/MathieuAbbal?y=${year}`);
            const data = await res.json();
            const contributions = data.contributions;

            const totalKey = year === 'last' ? 'lastYear' : year;
            const total = data.total[totalKey] || data.total.lastYear || 0;
            if (totalEl) totalEl.textContent = `${total} contributions${year === 'last' ? ' cette année' : ` en ${year}`}`;

            // Group by weeks
            const weeks: { date: string; count: number; level: number }[][] = [];
            let currentWeek: { date: string; count: number; level: number }[] = [];

            // Pad first week
            const firstDay = new Date(contributions[0].date).getDay();
            for (let i = 0; i < firstDay; i++) {
                currentWeek.push({ date: '', count: -1, level: -1 });
            }

            contributions.forEach((day: { date: string; count: number; level: number }) => {
                currentWeek.push(day);
                if (currentWeek.length === 7) {
                    weeks.push(currentWeek);
                    currentWeek = [];
                }
            });
            if (currentWeek.length > 0) {
                weeks.push(currentWeek);
            }

            const isDark = document.documentElement.classList.contains('dark');
            const colors = isDark ? DARK_COLORS : LIGHT_COLORS;

            // Month labels (X axis)
            const monthsEl = document.getElementById('contrib-months');
            if (monthsEl) {
                monthsEl.innerHTML = '';
                let lastMonth = -1;
                weeks.forEach((week, i) => {
                    const firstDay = week.find(d => d.level !== -1);
                    if (firstDay) {
                        const m = new Date(firstDay.date).getMonth();
                        if (m !== lastMonth) {
                            const span = document.createElement('span');
                            span.textContent = MONTHS[m];
                            span.style.position = 'absolute';
                            span.style.left = `${i * 12}px`;
                            monthsEl.appendChild(span);
                            lastMonth = m;
                        }
                    }
                });
                monthsEl.style.position = 'relative';
            }

            grid.innerHTML = '';
            weeks.forEach(week => {
                const col = document.createElement('div');
                col.className = 'flex flex-col gap-[2px]';
                week.forEach(day => {
                    const cell = document.createElement('div');
                    cell.className = 'w-[10px] h-[10px] rounded-[2px] cursor-pointer';
                    if (day.level === -1) {
                        cell.style.background = 'transparent';
                    } else {
                        cell.style.background = colors[day.level];
                        cell.dataset.date = day.date;
                        cell.dataset.count = String(day.count);

                        cell.addEventListener('mouseenter', () => {
                            if (!tooltip) return;
                            const tooltipText = document.getElementById('contrib-tooltip-text');
                            if (!tooltipText) return;
                            const d = new Date(day.date);
                            const label = day.count === 0
                                ? 'Aucune contribution'
                                : `${day.count} contribution${day.count > 1 ? 's' : ''}`;
                            tooltipText.textContent = `${label} le ${DAYS[d.getDay()]} ${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
                            tooltip.classList.remove('hidden');
                            const rect = cell.getBoundingClientRect();
                            const tw = tooltip.offsetWidth;
                            tooltip.style.left = `${rect.left + rect.width / 2 - tw / 2}px`;
                            tooltip.style.top = `${rect.top - tooltip.offsetHeight - 4}px`;
                        });
                        cell.addEventListener('mouseleave', () => {
                            tooltip?.classList.add('hidden');
                        });
                    }
                    col.appendChild(cell);
                });
                grid.appendChild(col);
            });
        } catch {
            grid.innerHTML = '<p class="text-sm text-gray-400">Impossible de charger les contributions.</p>';
        }
    }

    // Update colors on theme change
    function updateContribColors() {
        const isDark = document.documentElement.classList.contains('dark');
        const colors = isDark ? DARK_COLORS : LIGHT_COLORS;
        document.querySelectorAll('#contrib-grid [data-date]').forEach(cell => {
            const el = cell as HTMLElement;
            const count = parseInt(el.dataset.count || '0');
            let level = 0;
            if (count >= 20) level = 4;
            else if (count >= 10) level = 3;
            else if (count >= 5) level = 2;
            else if (count >= 1) level = 1;
            el.style.background = colors[level];
        });
    }

    const themeObs = new MutationObserver(updateContribColors);
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // Load when section is visible
    const ghSection = document.getElementById('github');
    if (ghSection) {
        const obs = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                obs.disconnect();
                buildYearSelector();
                loadContribGraph();
            }
        }, { rootMargin: '200px' });
        obs.observe(ghSection);
    }
</script>
