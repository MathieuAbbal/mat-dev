---
const startYear = 2021;
const yearsExp = new Date().getFullYear() - startYear;
const base = import.meta.env.BASE_URL;
---

<section id="about" class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:flex lg:items-center lg:gap-16">
            <!-- Profile Image & Contact -->
            <div class="lg:w-1/3 mb-10 lg:mb-0">
                <div class="text-center lg:text-left">
                    <img class="w-40 h-40 rounded-full mx-auto lg:mx-0 border-4 border-primary-100 dark:border-primary-900 shadow-lg object-cover"
                        src={`${base}img/profil.jpg`} alt="Mathieu Abbal" />

                    <div class="mt-6 space-y-3">
                        <div class="flex items-center justify-center lg:justify-start text-gray-600 dark:text-gray-400">
                            <i class="fas fa-map-marker-alt w-5 text-primary-600"></i>
                            <span class="ml-3">Pyrénées-Orientales, France</span>
                        </div>
                        <div class="flex items-center justify-center lg:justify-start text-gray-600 dark:text-gray-400">
                            <i class="fas fa-envelope w-5 text-primary-600"></i>
                            <span class="ml-3">mathieuabbal@hotmail.fr</span>
                        </div>
                        <div class="flex items-center justify-center lg:justify-start text-gray-600 dark:text-gray-400">
                            <i class="fas fa-phone w-5 text-primary-600"></i>
                            <span class="ml-3">06 17 59 35 21</span>
                        </div>
                    </div>

                    <!-- Social Links -->
                    <div class="flex justify-center lg:justify-start gap-4 mt-6">
                        <a href="https://github.com/MathieuAbbal" target="_blank"
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-primary-100 hover:text-primary-600 dark:hover:bg-primary-900 dark:hover:text-primary-400 transition-colors">
                            <i class="fab fa-github text-lg"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/mathieu-abbal/" target="_blank"
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-primary-100 hover:text-primary-600 dark:hover:bg-primary-900 dark:hover:text-primary-400 transition-colors">
                            <i class="fab fa-linkedin-in text-lg"></i>
                        </a>
                        <a href="https://twitter.com/Mathieu_dev_" target="_blank"
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-primary-100 hover:text-primary-600 dark:hover:bg-primary-900 dark:hover:text-primary-400 transition-colors">
                            <i class="fab fa-twitter text-lg"></i>
                        </a>
                    </div>


                </div>
            </div>

            <!-- Introduction Text -->
            <div class="lg:w-2/3">
                <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4">
                    Mathieu 
                </h1>
                <p class="text-xl text-primary-600 dark:text-primary-400 font-semibold mb-6">
                    Développeur Full Stack
                </p>

                <div class="prose prose-lg dark:prose-invert max-w-none">
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                        Développeur passionné spécialisé dans la conception d'applications web modernes et
                        performantes.
                        Actuellement chez <strong>Nanogis</strong>, je développe des solutions cartographiques
                        SIG
                        en utilisant Angular, TypeScript et des technologies de visualisation de données.
                    </p>
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                        Mon expertise couvre le développement front-end avec Angular et RxJS, l'intégration de
                        librairies de cartographie comme MapLibre, la visualisation de données avec Chart.js,
                        ainsi que le développement back-end avec LoopBack et MongoDB.
                    </p>
                </div>

                <!-- Quick Stats -->
                <div class="grid grid-cols-3 gap-6 mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">{yearsExp}+</div>
                        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Années d'expérience</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">Angular</div>
                        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Framework principal</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">SIG</div>
                        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Spécialisation</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
