                        <button data-style="satellite-plain" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-green-800 to-gray-900 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Satellite Plain</span>
