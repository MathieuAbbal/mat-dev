                        <button data-style="streets" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-blue-300 to-blue-500 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Streets</span>
                        </button>
                        <button data-style="toner" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-gray-100 to-gray-900 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Toner</span>
                        </button>
                        <button data-style="topo" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-amber-300 to-orange-500 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Topo</span>
                        </button>
                        <button data-style="winter" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-sky-200 to-blue-300 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Winter</span>
                        </button>
                    </div>
                </div>
                <!-- 3D Toggle -->
                <button id="toggle-3d" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 hover:bg-white dark:hover:bg-slate-800 transition-colors" title="Activer/Désactiver le relief 3D">
                    <svg class="w-4 h-4 text-gray-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                    <span class="text-xs font-medium text-gray-700 dark:text-slate-300 hidden sm:inline">3D</span>
                </button>
                <!-- Measure Toggle -->
                <button id="toggle-measure" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 hover:bg-white dark:hover:bg-slate-800 transition-colors" title="Mesurer une distance">
                    <svg class="w-4 h-4 text-gray-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l3-3 3 3 3-3 3 3 3-3 3 3M6 9V6m6 3V6m6 3V6" /></svg>
                    <span class="text-xs font-medium text-gray-700 dark:text-slate-300 hidden sm:inline">Mesurer</span>
                </button>
                <!-- Theme Toggle -->
                <button id="map-theme-toggle" class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 hover:bg-white dark:hover:bg-slate-800 transition-colors" aria-label="Changer le thème de la carte" title="Thème de la carte">
                    <svg class="map-theme-sun w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    <svg class="map-theme-moon w-4 h-4 text-indigo-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                </button>
                <!-- Fullscreen Toggle -->
                <button id="map-fullscreen-toggle" class="hidden md:flex items-center justify-center w-10 h-10 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 hover:bg-white dark:hover:bg-slate-800 transition-colors" aria-label="Plein écran" title="Plein écran">
                    <svg class="fs-expand w-4 h-4 text-gray-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/></svg>
                    <svg class="fs-compress w-4 h-4 text-gray-600 dark:text-slate-300 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V5m0 4H5m0 0l4-4m6 4V5m0 4h4m0 0l-4-4M9 15v4m0-4H5m0 0l4 4m6-4v4m0-4h4m0 0l-4 4"/></svg>
                </button>
                <!-- Close button -->
                <button id="map-modal-close" class="w-10 h-10 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 flex items-center justify-center hover:bg-white dark:hover:bg-slate-800 transition-colors">
                    <svg class="w-5 h-5 text-gray-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <!-- Label -->
            <div class="absolute bottom-4 left-4 px-4 py-2 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 flex items-center gap-2 z-10">
                <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span class="text-sm font-medium text-gray-700 dark:text-slate-300">Pyrénées-Orientales, France</span>
            </div>
            <!-- Measure result panel -->
            <div id="measure-panel" class="hidden absolute bottom-12 right-4 px-4 py-2 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-indigo-300 dark:border-indigo-500/50 z-10">
                <div class="text-[10px] uppercase tracking-wider text-gray-500 dark:text-slate-500">Distance</div>
                <div class="text-base font-bold text-indigo-600 dark:text-indigo-400" id="measure-result">—</div>
                <div class="text-[10px] text-gray-400 dark:text-slate-500" id="measure-hint">Cliquez pour ajouter des points</div>
            </div>
        </div>
    </div>
</div>

<script>
    // Typing effect
    const words = ['Angular', 'SIG', 'MapLibre', 'TypeScript'];
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typingEl = document.getElementById('typing-text');

    function type() {
        if (!typingEl) return;
        const currentWord = words[wordIndex];

        if (isDeleting) {
            typingEl.textContent = currentWord.substring(0, charIndex - 1);
            charIndex--;
        } else {
            typingEl.textContent = currentWord.substring(0, charIndex + 1);
            charIndex++;
        }

        let timeout = isDeleting ? 50 : 100;

        if (!isDeleting && charIndex === currentWord.length) {
            timeout = 2000;
            isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
            isDeleting = false;
            wordIndex = (wordIndex + 1) % words.length;
            timeout = 500;
        }

        setTimeout(type, timeout);
    }

    type();

    // Animated radar chart
    const radarPolygon = document.getElementById('radar-data');
    const radarChart = document.getElementById('radar-chart');
    if (radarPolygon && radarChart) {
        const radarObs = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            radarObs.disconnect();
            setTimeout(() => {
                radarPolygon.setAttribute('points', '150,42 249,119 206,239 87,232 47,121');
                document.querySelectorAll<SVGCircleElement>('.radar-point').forEach(pt => {
                    pt.setAttribute('cx', pt.dataset.cx || '150');
                    pt.setAttribute('cy', pt.dataset.cy || '150');
                    pt.setAttribute('r', '4');
                });
            }, 100);
        }, { threshold: 0.4 });
        radarObs.observe(radarChart);
    }

    // Animated counters
    const counters = document.querySelectorAll('.counter');
    const counterObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            counterObs.unobserve(entry.target);
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.target || '0');
            const duration = 1500;
            const start = performance.now();
            const animate = (now: number) => {
                const t = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - t, 3);
                el.textContent = Math.round(target * eased).toString();
                if (t < 1) requestAnimationFrame(animate);
            };
            requestAnimationFrame(animate);
        });
    }, { threshold: 0.3 });
    counters.forEach(c => counterObs.observe(c));

    // Copy code button
    const copyBtn = document.getElementById('copy-code');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');
    const codeText = `const mathieu = {\n  role: "Full Stack Developer",\n  company: "Nanogis",\n  stack: ["Angular", "TypeScript", "MapLibre", "Chart.js"],\n  passion: "SIG & Cartographie"\n};`;

    copyBtn?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(codeText);
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
        }, 2000);
    });

    // Lazy-load MapLibre
    const ML_CSS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css';
    const ML_JS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
    let mlLoaded = !!(window as any).maplibregl;
    let heroMap: any = null;

    // Map dark mode state (auto follows system preference)
    let mapDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const sysObs = window.matchMedia('(prefers-color-scheme: dark)');
    sysObs.addEventListener('change', (e) => {
        mapDarkMode = e.matches;
        refreshMapStyles();
    });

    function refreshMapStyles() {
        if (heroMap) {
            heroMap.setStyle(mapDarkMode
                ? 'https://api.maptiler.com/maps/dataviz-dark/style.json?key=gFo9NAK14hwpQNC0vjKE'
                : 'https://api.maptiler.com/maps/dataviz-light/style.json?key=gFo9NAK14hwpQNC0vjKE');
        }
        if (modalMap) {
            modalMap.setStyle(getMapStyle());
            modalMap.once('style.load', () => { if (is3D) addTerrain(); });
        }
        // Update toggle icon
        const sunIcon = document.querySelector('.map-theme-sun');
        const moonIcon = document.querySelector('.map-theme-moon');
        sunIcon?.classList.toggle('hidden', !mapDarkMode);
        moonIcon?.classList.toggle('hidden', mapDarkMode);
    }

    function loadMapLibre(): Promise<void> {
        if (mlLoaded) return Promise.resolve();
        return new Promise((resolve) => {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = ML_CSS;
            document.head.appendChild(link);

            const script = document.createElement('script');
            script.src = ML_JS;
            script.onload = () => { mlLoaded = true; resolve(); };
            document.head.appendChild(script);
        });
    }

    // Lazy-load MapTiler Geocoder
    const GC_CSS = 'https://cdn.maptiler.com/maptiler-geocoding-control/v2.1.4/style.css';
    const GC_JS = 'https://cdn.maptiler.com/maptiler-geocoding-control/v2.1.4/maplibregl.umd.js';
    let gcLoaded = false;
    function loadGeocoder(): Promise<void> {
        if (gcLoaded) return Promise.resolve();
        return new Promise((resolve) => {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = GC_CSS;
            document.head.appendChild(link);
            const script = document.createElement('script');
            script.src = GC_JS;
            script.onload = () => { gcLoaded = true; resolve(); };
            document.head.appendChild(script);
        });
    }

    function initHeroMap() {
        const mapContainer = document.getElementById('hero-map');
        if (!mapContainer || !(window as any).maplibregl || heroMap) return;

        heroMap = new (window as any).maplibregl.Map({
            container: 'hero-map',
            style: mapDarkMode
                ? 'https://api.maptiler.com/maps/dataviz-dark/style.json?key=gFo9NAK14hwpQNC0vjKE'
                : 'https://api.maptiler.com/maps/dataviz-light/style.json?key=gFo9NAK14hwpQNC0vjKE',
            center: [2.89, 42.7],
            zoom: 8,
            interactive: false,
            attributionControl: false,
        });

        heroMap.on('load', () => {
            const markerEl = document.createElement('div');
            markerEl.innerHTML = `<div style="width:16px;height:16px;background:#4264fb;border-radius:50%;border:3px solid white;box-shadow:0 0 12px rgba(66,100,251,0.6);"></div>`;
            new (window as any).maplibregl.Marker({ element: markerEl })
                .setLngLat([2.89, 42.7])
                .addTo(heroMap);
        });

    }

    // Load MapLibre when map card enters viewport
    const mapCardEl = document.getElementById('map-card');
    if (mapCardEl) {
        const mapObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                mapObserver.disconnect();
                loadMapLibre().then(initHeroMap);
            }
        }, { rootMargin: '200px' });
        mapObserver.observe(mapCardEl);
    }

    // Map modal
    const mapCard = document.getElementById('map-card');
    const mapModal = document.getElementById('map-modal');
    const mapModalOverlay = document.getElementById('map-modal-overlay');
    const mapModalClose = document.getElementById('map-modal-close');
    let modalMap: any = null;
    let modalMapReady = false;

    let currentStyleKey = 'dataviz';
    function getMapStyle() {
        return mapStyles[currentStyleKey]?.url() || mapStyles.dataviz.url();
    }

    async function openMapModal() {
        if (!mapModal) return;
        await loadMapLibre();
        mapModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        if (!modalMap) {
            modalMap = new (window as any).maplibregl.Map({
                container: 'modal-map',
                style: getMapStyle(),
                center: [2.89, 42.7],
                zoom: 10,
                maxPitch: 85,
                attributionControl: true,
            });

            modalMap.addControl(new (window as any).maplibregl.NavigationControl({ visualizePitch: true }), 'top-left');

            // Geolocate control
            const geolocate = new (window as any).maplibregl.GeolocateControl({
                positionOptions: { enableHighAccuracy: true },
                trackUserLocation: true,
                showUserHeading: true,
            });
            modalMap.addControl(geolocate, 'top-left');

            // Geocoder (search bar) - moved to top-right toolbar
            loadGeocoder().then(() => {
                const w = window as any;
                const ns = w.maplibreglMaptilerGeocoder || w.maptilerGeocodingControl;
                if (!ns) return;
                const gc = new ns.GeocodingControl({
                    apiKey: 'gFo9NAK14hwpQNC0vjKE',
                    language: 'fr',
                    placeholder: 'Rechercher un lieu...',
                    flyTo: true,
                });
                modalMap.addControl(gc, 'top-right');
                // Move into our custom toolbar container
                setTimeout(() => {
                    const target = document.getElementById('modal-geocoder');
                    const ctrl = document.querySelector('.maplibregl-ctrl-top-right .maplibregl-ctrl input')?.closest('.maplibregl-ctrl') as HTMLElement;
                    if (target && ctrl) {
                        target.appendChild(ctrl);
                    }
                }, 100);
            });

            // Persistent marker (Perpignan)
            const modalMarkerEl = document.createElement('div');
            modalMarkerEl.innerHTML = `<div style="width:20px;height:20px;background:#4264fb;border-radius:50%;border:3px solid white;box-shadow:0 0 12px rgba(66,100,251,0.5)"></div>`;
            const modalMarker = new (window as any).maplibregl.Marker({ element: modalMarkerEl })
                .setLngLat([2.89, 42.7]);

            modalMap.on('load', () => {
                modalMapReady = true;
                modalMarker.addTo(modalMap);
            });
        } else {
            modalMap.resize();
        }
    }

    function closeMapModal() {
        mapModal?.classList.add('hidden');
        document.body.style.overflow = '';
    }

    mapCard?.addEventListener('click', openMapModal);
    mapModalClose?.addEventListener('click', closeMapModal);
    mapModalOverlay?.addEventListener('click', closeMapModal);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMapModal();
    });

    // 3D Terrain toggle
    const toggle3d = document.getElementById('toggle-3d');
    let is3D = false;
    const TERRAIN_URL = `https://api.maptiler.com/tiles/terrain-rgb-v2/tiles.json?key=gFo9NAK14hwpQNC0vjKE`;

    function addTerrain() {
        if (!modalMap) return;
        if (!modalMap.getSource('terrain-source')) {
            modalMap.addSource('terrain-source', { type: 'raster-dem', url: TERRAIN_URL, tileSize: 256 });
        }
        modalMap.setTerrain({ source: 'terrain-source', exaggeration: 1.5 });
    }

    function removeTerrain() {
        if (!modalMap) return;
        modalMap.setTerrain(null);
    }

    toggle3d?.addEventListener('click', () => {
        if (!modalMap) return;
        is3D = !is3D;
        if (is3D) {
            addTerrain();
            modalMap.easeTo({ pitch: 60, duration: 1000 });
            toggle3d.classList.add('ring-2', 'ring-indigo-500/50', 'border-indigo-400', 'dark:border-indigo-500');
        } else {
            removeTerrain();
            modalMap.easeTo({ pitch: 0, duration: 1000 });
            toggle3d.classList.remove('ring-2', 'ring-indigo-500/50', 'border-indigo-400', 'dark:border-indigo-500');
        }
    });

    // Distance measurement
    // Map fullscreen toggle (Fullscreen API on the modal)
    const fsToggle = document.getElementById('map-fullscreen-toggle');
    const fsExpand = document.querySelector('.fs-expand');
    const fsCompress = document.querySelector('.fs-compress');
    fsToggle?.addEventListener('click', async () => {
        if (!document.fullscreenElement) {
            await mapModal?.requestFullscreen?.();
        } else {
            await document.exitFullscreen?.();
        }
    });
    document.addEventListener('fullscreenchange', () => {
        const isFs = !!document.fullscreenElement;
        fsExpand?.classList.toggle('hidden', isFs);
        fsCompress?.classList.toggle('hidden', !isFs);
        modalMap?.resize?.();
    });

    // Map theme toggle
    const mapThemeToggle = document.getElementById('map-theme-toggle');
    mapThemeToggle?.addEventListener('click', () => {
        mapDarkMode = !mapDarkMode;
        refreshMapStyles();
    });
    // Set initial icon state on load
    setTimeout(() => {
        const sunIcon = document.querySelector('.map-theme-sun');
        const moonIcon = document.querySelector('.map-theme-moon');
        sunIcon?.classList.toggle('hidden', !mapDarkMode);
        moonIcon?.classList.toggle('hidden', mapDarkMode);
    }, 0);

    const toggleMeasure = document.getElementById('toggle-measure');
    const measurePanel = document.getElementById('measure-panel');
    const measureResult = document.getElementById('measure-result');
    const measureHint = document.getElementById('measure-hint');
    let measureMode = false;
    let measurePoints: number[][] = [];

    function haversine(a: number[], b: number[]): number {
        const R = 6371;
        const toRad = (d: number) => (d * Math.PI) / 180;
        const dLat = toRad(b[1] - a[1]);
        const dLon = toRad(b[0] - a[0]);
        const lat1 = toRad(a[1]);
        const lat2 = toRad(b[1]);
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
        return 2 * R * Math.asin(Math.sqrt(h));
    }

    function totalDistance(): number {
        let total = 0;
        for (let i = 1; i < measurePoints.length; i++) {
            total += haversine(measurePoints[i - 1], measurePoints[i]);
        }
        return total;
    }

    function formatDistance(km: number): string {
        if (km < 1) return `${Math.round(km * 1000)} m`;
        return `${km.toFixed(2)} km`;
    }

    function updateMeasureLayer() {
        if (!modalMap) return;
        const src = modalMap.getSource('measure-line');
        const lineData = {
            type: 'Feature',
            geometry: { type: 'LineString', coordinates: measurePoints },
            properties: {},
        };
        if (src) {
            src.setData(lineData);
        } else {
            modalMap.addSource('measure-line', { type: 'geojson', data: lineData });
            modalMap.addLayer({
                id: 'measure-line-layer',
                type: 'line',
                source: 'measure-line',
                paint: {
                    'line-color': '#6366f1',
                    'line-width': 3,
                    'line-dasharray': [2, 2],
                },
            });
        }

        const ptsSrc = modalMap.getSource('measure-points');
        const ptsData = {
            type: 'FeatureCollection',
            features: measurePoints.map((p, i) => ({
                type: 'Feature',
                geometry: { type: 'Point', coordinates: p },
                properties: { index: i },
            })),
        };
        if (ptsSrc) {
            ptsSrc.setData(ptsData);
        } else {
            modalMap.addSource('measure-points', { type: 'geojson', data: ptsData });
            modalMap.addLayer({
                id: 'measure-points-layer',
                type: 'circle',
                source: 'measure-points',
                paint: {
                    'circle-radius': 5,
                    'circle-color': '#6366f1',
                    'circle-stroke-width': 2,
                    'circle-stroke-color': '#ffffff',
                },
            });
        }
    }

    function clearMeasure() {
        if (!modalMap) return;
        if (modalMap.getLayer('measure-line-layer')) modalMap.removeLayer('measure-line-layer');
        if (modalMap.getLayer('measure-points-layer')) modalMap.removeLayer('measure-points-layer');
        if (modalMap.getSource('measure-line')) modalMap.removeSource('measure-line');
        if (modalMap.getSource('measure-points')) modalMap.removeSource('measure-points');
        measurePoints = [];
        if (measureResult) measureResult.textContent = '—';
    }

    function onMapClick(e: any) {
        measurePoints.push([e.lngLat.lng, e.lngLat.lat]);
        updateMeasureLayer();
        if (measureResult) measureResult.textContent = formatDistance(totalDistance());
        if (measureHint) measureHint.textContent = measurePoints.length < 2 ? 'Ajoutez un autre point' : 'Cliquez pour continuer';
    }

    toggleMeasure?.addEventListener('click', () => {
        if (!modalMap) return;
        measureMode = !measureMode;
        if (measureMode) {
            measurePanel?.classList.remove('hidden');
            modalMap.getCanvas().style.cursor = 'crosshair';
            modalMap.on('click', onMapClick);
            toggleMeasure.classList.add('ring-2', 'ring-indigo-500/50', 'border-indigo-400', 'dark:border-indigo-500');
        } else {
            measurePanel?.classList.add('hidden');
            modalMap.getCanvas().style.cursor = '';
            modalMap.off('click', onMapClick);
            clearMeasure();
            toggleMeasure.classList.remove('ring-2', 'ring-indigo-500/50', 'border-indigo-400', 'dark:border-indigo-500');
        }
    });

    // Style selector
    const KEY = 'gFo9NAK14hwpQNC0vjKE';
    const dark = () => mapDarkMode;
    const mt = (id: string) => `https://api.maptiler.com/maps/${id}/style.json?key=${KEY}`;

    const mapStyles: Record<string, { url: () => string; name: string }> = {
        aquarelle:        { url: () => mt('aquarelle'),                          name: 'Aquarelle' },
        backdrop:         { url: () => mt(dark() ? 'backdrop-dark' : 'backdrop'),name: 'Backdrop' },
        basic:            { url: () => mt(dark() ? 'basic-v2-dark' : 'basic-v2'), name: 'Base' },
        dataviz:          { url: () => mt(dark() ? 'dataviz-dark' : 'dataviz-light'), name: 'DataViz' },
        landscape:        { url: () => mt(dark() ? 'landscape-dark' : 'landscape'), name: 'Landscape' },
        ocean:            { url: () => mt('ocean'),                              name: 'Ocean' },
        openstreetmap:    { url: () => mt('openstreetmap'),                      name: 'OpenStreetMap' },
        outdoor:          { url: () => mt(dark() ? 'outdoor-v2-dark' : 'outdoor-v2'), name: 'Outdoor' },
        satellite:        { url: () => mt('satellite'),                          name: 'Satellite Hybrid' },
        'satellite-plain':{ url: () => mt('satellite'),                          name: 'Satellite Plain' },
        streets:          { url: () => mt(dark() ? 'streets-v2-dark' : 'streets-v2'), name: 'Streets' },
        toner:            { url: () => mt(dark() ? 'toner-v2-dark' : 'toner-v2'), name: 'Toner' },
        topo:             { url: () => mt(dark() ? 'topo-v2-dark' : 'topo-v2'), name: 'Topo' },
        winter:           { url: () => mt(dark() ? 'winter-v2-dark' : 'winter-v2'), name: 'Winter' },
    };

    const styleToggle = document.getElementById('style-toggle');
    const styleDropdown = document.getElementById('style-dropdown');
    const styleOptions = document.querySelectorAll('.style-option');
    const currentStyleName = document.getElementById('current-style-name');

    styleToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        styleDropdown?.classList.toggle('hidden');
    });

    // Close dropdown on outside click
    document.addEventListener('click', () => {
        styleDropdown?.classList.add('hidden');
    });

    styleOptions.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const styleKey = (btn as HTMLElement).dataset.style || 'dataviz';
            const style = mapStyles[styleKey];
            if (modalMap && style) {
                currentStyleKey = styleKey;
                try {
                    modalMap.setStyle(style.url());
                    modalMap.once('style.load', () => {
                        modalMapReady = true;
                        if (is3D) addTerrain();
                        if (measureMode && measurePoints.length > 0) updateMeasureLayer();
                    });
                } catch (err) {
                    console.error('Style change failed:', err);
                }
                if (currentStyleName) currentStyleName.textContent = style.name;
            }
            styleDropdown?.classList.add('hidden');
        });
    });
</script>
