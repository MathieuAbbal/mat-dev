                    <div class="relative group p-3 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800/50 backdrop-blur-sm text-center glow-hover">
                        <div class="text-2xl sm:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#818cf8] dark:to-[#22d3ee]">{yearsExp}+</div>
                        <div class="text-xs sm:text-sm text-gray-500 dark:text-slate-500 mt-1">Années d'exp.</div>
                    </div>
