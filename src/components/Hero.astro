---
const startYear = 2021;
const yearsExp = new Date().getFullYear() - startYear;
const base = import.meta.env.BASE_URL;
---

<section id="about" class="relative py-12 sm:py-20 lg:py-32 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-2/3 h-2/3 bg-indigo-500/5 dark:bg-indigo-500/10 blur-[120px] rounded-full"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:flex lg:items-center lg:gap-16">
            <!-- Profile Image & Contact -->
            <div class="lg:w-1/3 mb-10 lg:mb-0 reveal">
                <div class="text-center lg:text-left">
                    <img class="w-32 h-32 sm:w-44 sm:h-44 rounded-full mx-auto lg:mx-0 border-4 border-indigo-200 dark:border-indigo-500/30 shadow-xl shadow-indigo-500/20 object-cover"
                        src={`${base}img/profil.jpg`} alt="Mathieu - Développeur Full Stack Angular & SIG"
                        width="176" height="176" loading="eager" decoding="async" />

                    <div class="mt-8 space-y-3">
                        <div class="flex items-center justify-center lg:justify-start text-gray-500 dark:text-slate-400 group">
                            <i class="fas fa-map-marker-alt w-5 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform"></i>
                            <span class="ml-3">Pyrénées-Orientales, France</span>
                        </div>
                        <a href="mailto:mathieuabbal@hotmail.fr" class="flex items-center justify-center lg:justify-start text-gray-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors group">
                            <i class="fas fa-envelope w-5 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform"></i>
                            <span class="ml-3">mathieuabbal@hotmail.fr</span>
                        </a>
                        <a href="tel:+33617593521" class="flex items-center justify-center lg:justify-start text-gray-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors group">
                            <i class="fas fa-phone w-5 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform"></i>
                            <span class="ml-3">06 17 59 35 21</span>
                        </a>
                    </div>

                    <!-- Social Links -->
                    <div class="flex justify-center lg:justify-start gap-3 mt-6">
                        <a href="https://github.com/MathieuAbbal" target="_blank" rel="noopener" aria-label="Profil GitHub"
                            class="w-11 h-11 flex items-center justify-center rounded-xl bg-gray-100 dark:bg-slate-800/80 text-gray-500 dark:text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-110 hover:-translate-y-1 transition-all duration-300">
                            <i class="fab fa-github text-lg"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/mathieuabbal/" target="_blank" rel="noopener" aria-label="Profil LinkedIn"
                            class="w-11 h-11 flex items-center justify-center rounded-xl bg-gray-100 dark:bg-slate-800/80 text-gray-500 dark:text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-110 hover:-translate-y-1 transition-all duration-300">
                            <i class="fab fa-linkedin-in text-lg"></i>
                        </a>
                        <a href="https://twitter.com/Mathieu_dev_" target="_blank" rel="noopener" aria-label="Profil Twitter"
                            class="w-11 h-11 flex items-center justify-center rounded-xl bg-gray-100 dark:bg-slate-800/80 text-gray-500 dark:text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-110 hover:-translate-y-1 transition-all duration-300">
                            <i class="fab fa-twitter text-lg"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Introduction Text -->
            <div class="lg:w-2/3">
                <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-gray-900 dark:text-white mb-2 reveal reveal-delay-1">
                    Salut, je suis
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd] animated-gradient" id="hero-name">Mathieu</span>
                </h1>
                <div class="mb-6 reveal reveal-delay-2">
                    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-50 dark:bg-[#0c0c1a] border border-gray-200 dark:border-slate-700/30 font-mono text-sm sm:text-base">
                        <span class="text-indigo-500 dark:text-[#cba6f7]">&gt;</span>
                        <span class="text-gray-700 dark:text-slate-300">Développeur Full Stack</span>
                        <span class="text-indigo-600 dark:text-[#65d9fd] typing-cursor" id="typing-text"></span>
                    </span>
                </div>

                <div class="max-w-none reveal reveal-delay-3">
                    <p class="text-gray-600 dark:text-slate-400 leading-relaxed mb-4 text-base sm:text-lg">
                        Développeur passionné spécialisé dans la conception d'applications web modernes et
                        performantes.
                        Actuellement chez <strong class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd]">Nanogis</strong>, je développe des solutions cartographiques
                        SIG
                        en utilisant Angular, TypeScript et des technologies de visualisation de données.
                    </p>
                    <p class="text-gray-600 dark:text-slate-400 leading-relaxed text-base sm:text-lg">
                        Mon expertise couvre le développement front-end avec Angular et RxJS, l'intégration de
                        librairies de cartographie comme MapLibre, la visualisation de données avec Chart.js,
                        ainsi que le développement back-end avec LoopBack et MongoDB.
                    </p>
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-wrap gap-3 mt-8 reveal reveal-delay-3">
                    <a href="#projects" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-gradient-to-br from-indigo-500 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd] text-white font-semibold shadow-md shadow-indigo-500/30 hover:shadow-lg hover:shadow-indigo-500/50 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                        Voir mes projets
                    </a>
                    <a href="#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white dark:bg-slate-900/50 border border-gray-300 dark:border-slate-700 text-gray-700 dark:text-slate-200 font-semibold hover:border-indigo-500 dark:hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        Me contacter
                    </a>
                </div>

                <!-- Quick Stats -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mt-8 sm:mt-10 reveal reveal-delay-4">
                    <div class="relative group p-3 sm:p-5 rounded-lg bg-white dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800/50 backdrop-blur-sm text-center glow-hover">
                        <div class="text-2xl sm:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd]"><span class="counter" data-target={yearsExp}>0</span>+</div>
                        <div class="text-xs sm:text-sm text-gray-500 dark:text-slate-500 mt-1">Années d'exp.</div>
                    </div>
                    <div class="relative group p-3 sm:p-5 rounded-lg bg-white dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800/50 backdrop-blur-sm text-center glow-hover">
                        <div class="text-2xl sm:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd]">Angular</div>
                        <div class="text-xs sm:text-sm text-gray-500 dark:text-slate-500 mt-1">Framework</div>
                    </div>
                    <div class="relative group p-3 sm:p-5 rounded-lg bg-white dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800/50 backdrop-blur-sm text-center glow-hover">
                        <div class="text-2xl sm:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd]">SIG</div>
                        <div class="text-xs sm:text-sm text-gray-500 dark:text-slate-500 mt-1">Spécialisation</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Code Block + Radar + Map -->
        <div class="dark mt-8 sm:mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 reveal">
            <!-- Code Block -->
            <div class="relative rounded-lg bg-white dark:bg-[#0c0c1a] border border-gray-200 dark:border-slate-700/30 overflow-hidden shadow-2xl shadow-indigo-500/5">
                <!-- Title bar -->
                <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 dark:bg-[#111119] border-b border-gray-200 dark:border-gray-700/30">
                    <span class="text-xs text-gray-500 dark:text-gray-400 font-mono">mathieu.ts</span>
                    <button id="copy-code" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 transition-colors p-1" title="Copier">
                        <svg id="copy-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                        <svg id="check-icon" class="w-4 h-4 hidden text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    </button>
                </div>
                <!-- Code content -->
                <div class="p-4 sm:p-5 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto">
                    <div>
                        <span class="text-indigo-600 dark:text-[#7886fc]">const</span> <span class="text-cyan-600 dark:text-[#65d9fd]">mathieu</span> <span class="text-gray-400 dark:text-slate-500">=</span> <span class="text-indigo-500 dark:text-[#7886fc]">&#123;</span>
                    </div>
                    <div class="ml-6">
                        <span class="text-gray-700 dark:text-slate-200">role</span><span class="text-gray-400 dark:text-[#6c7086]">:</span> <span class="text-cyan-700 dark:text-[#65d9fd]">"Full Stack Developer"</span><span class="text-gray-400 dark:text-[#6c7086]">,</span>
                    </div>
                    <div class="ml-6">
                        <span class="text-gray-700 dark:text-slate-200">company</span><span class="text-gray-400 dark:text-[#6c7086]">:</span> <span class="text-cyan-700 dark:text-[#65d9fd]">"Nanogis"</span><span class="text-gray-400 dark:text-[#6c7086]">,</span>
                    </div>
                    <div class="ml-6">
                        <span class="text-gray-700 dark:text-slate-200">stack</span><span class="text-gray-400 dark:text-[#6c7086]">:</span> <span class="text-gray-400 dark:text-slate-500">[</span><span class="text-cyan-700 dark:text-[#65d9fd]">"Angular"</span><span class="text-gray-400 dark:text-[#6c7086]">,</span> <span class="text-cyan-700 dark:text-[#65d9fd]">"TypeScript"</span><span class="text-gray-400 dark:text-[#6c7086]">,</span> <span class="text-cyan-700 dark:text-[#65d9fd]">"MapLibre"</span><span class="text-gray-400 dark:text-[#6c7086]">,</span> <span class="text-cyan-700 dark:text-[#65d9fd]">"Chart.js"</span><span class="text-gray-400 dark:text-slate-500">]</span><span class="text-gray-400 dark:text-[#6c7086]">,</span>
                    </div>
                    <div class="ml-6">
                        <span class="text-gray-700 dark:text-slate-200">passion</span><span class="text-gray-400 dark:text-[#6c7086]">:</span> <span class="text-cyan-700 dark:text-[#65d9fd]">"SIG &amp; Cartographie"</span>
                    </div>
                    <div>
                        <span class="text-indigo-500 dark:text-[#7886fc]">&#125;</span><span class="text-gray-400 dark:text-[#6c7086]">;</span>
                    </div>
                </div>
            </div>

            <!-- Radar Chart -->
            <div class="relative rounded-lg bg-white dark:bg-[#0c0c1a] border border-gray-200 dark:border-slate-700/30 overflow-hidden shadow-2xl shadow-indigo-500/5 flex items-center justify-center p-4">
                <svg viewBox="-60 0 420 300" class="w-full max-w-[320px]" id="radar-chart">
                    <!-- Grid pentagons -->
                    <g class="text-gray-200 dark:text-slate-800">
                        <polygon points="150,30 264,113 220,247 80,247 36,113" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
                        <polygon points="150,54 240,122 204,229 96,229 60,122" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
                        <polygon points="150,78 216,131 188,211 112,211 84,131" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
                        <polygon points="150,102 192,140 172,193 128,193 108,140" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
                        <!-- Axis lines -->
                        <line x1="150" y1="150" x2="150" y2="30" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                        <line x1="150" y1="150" x2="264" y2="113" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                        <line x1="150" y1="150" x2="220" y2="247" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                        <line x1="150" y1="150" x2="80" y2="247" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                        <line x1="150" y1="150" x2="36" y2="113" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                    </g>
                    <!-- Data polygon (Frontend:90, Backend:75, Carto:95, Dataviz:80, Archi:70) -->
                    <polygon
                        id="radar-data"
                        points="150,150 150,150 150,150 150,150 150,150"
                        class="fill-indigo-500/20 dark:fill-indigo-400/15 stroke-indigo-500 dark:stroke-indigo-400"
                        stroke-width="2"
                        style="transition: points 1.2s cubic-bezier(0.16, 1, 0.3, 1)"
                    />
                    <!-- Data points -->
                    <circle class="radar-point fill-indigo-500 dark:fill-indigo-400" cx="150" cy="150" r="0" data-cx="150" data-cy="42" style="transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s"/>
                    <circle class="radar-point fill-indigo-500 dark:fill-indigo-400" cx="150" cy="150" r="0" data-cx="249" data-cy="119" style="transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s"/>
                    <circle class="radar-point fill-indigo-500 dark:fill-indigo-400" cx="150" cy="150" r="0" data-cx="206" data-cy="239" style="transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.4s"/>
                    <circle class="radar-point fill-indigo-500 dark:fill-indigo-400" cx="150" cy="150" r="0" data-cx="87" data-cy="232" style="transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s"/>
                    <circle class="radar-point fill-indigo-500 dark:fill-indigo-400" cx="150" cy="150" r="0" data-cx="47" data-cy="121" style="transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.6s"/>
                    <!-- Labels -->
                    <text x="150" y="18" text-anchor="middle" class="fill-gray-700 dark:fill-slate-300 text-[11px] font-semibold">Frontend</text>
                    <text x="150" y="28" text-anchor="middle" class="fill-indigo-500 dark:fill-indigo-400 text-[10px]">90%</text>
                    <text x="278" y="115" text-anchor="start" class="fill-gray-700 dark:fill-slate-300 text-[11px] font-semibold">Backend</text>
                    <text x="278" y="127" text-anchor="start" class="fill-indigo-500 dark:fill-indigo-400 text-[10px]">75%</text>
                    <text x="228" y="262" text-anchor="start" class="fill-gray-700 dark:fill-slate-300 text-[11px] font-semibold">Dataviz</text>
                    <text x="228" y="274" text-anchor="start" class="fill-indigo-500 dark:fill-indigo-400 text-[10px]">80%</text>
                    <text x="72" y="262" text-anchor="end" class="fill-gray-700 dark:fill-slate-300 text-[11px] font-semibold">Cartographie</text>
                    <text x="72" y="274" text-anchor="end" class="fill-indigo-500 dark:fill-indigo-400 text-[10px]">95%</text>
                    <text x="22" y="115" text-anchor="end" class="fill-gray-700 dark:fill-slate-300 text-[11px] font-semibold">Architecture</text>
                    <text x="22" y="127" text-anchor="end" class="fill-indigo-500 dark:fill-indigo-400 text-[10px]">70%</text>
                </svg>
            </div>

            <!-- MapLibre Card -->
            <div id="map-card" class="relative rounded-lg border border-gray-200 dark:border-slate-700/30 overflow-hidden shadow-2xl shadow-indigo-500/5 cursor-pointer group/map">
                <div id="hero-map" class="w-full h-full min-h-[220px]"></div>
                <!-- Overlay label -->
                <div class="absolute bottom-3 left-3 px-3 py-1.5 rounded-lg bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 flex items-center gap-2">
                    <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <span class="text-xs font-medium text-gray-700 dark:text-slate-300">Pyrénées-Orientales</span>
                </div>
                <!-- Expand icon -->
                <div class="absolute top-3 right-3 w-8 h-8 rounded-lg bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 flex items-center justify-center opacity-0 group-hover/map:opacity-100 transition-opacity">
                    <svg class="w-4 h-4 text-gray-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" /></svg>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Modal -->
<div id="map-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="map-modal-overlay"></div>
    <div class="absolute inset-4 sm:inset-8 lg:inset-16 flex flex-col">
        <div class="relative flex-1 rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700/30 shadow-2xl">
            <div id="modal-map" class="w-full h-full"></div>
            <!-- Top bar -->
            <!-- Geocoder centered at top -->
            <div id="modal-geocoder" class="absolute top-4 left-1/2 -translate-x-1/2 z-10 w-[280px] sm:w-[400px] [&_.maplibregl-ctrl]:!shadow-md"></div>
            <div class="absolute top-4 right-4 flex items-center gap-2 z-10">
                <!-- Style selector -->
                <div class="relative" id="style-selector">
                    <button id="style-toggle" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 hover:bg-white dark:hover:bg-slate-800 transition-colors">
                        <svg class="w-4 h-4 text-gray-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
                        <span class="text-xs font-medium text-gray-700 dark:text-slate-300 hidden sm:inline" id="current-style-name">DataViz</span>
                        <svg class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>
                    <div id="style-dropdown" class="hidden absolute top-full right-0 mt-2 w-52 py-1 rounded-xl bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm border border-gray-200 dark:border-slate-700/50 shadow-xl max-h-[70vh] overflow-y-auto">
                        <button data-style="aquarelle" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-amber-200 to-rose-300 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Aquarelle</span>
                        </button>
                        <button data-style="backdrop" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-slate-300 to-slate-500 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Backdrop</span>
                        </button>
                        <button data-style="basic" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-gray-200 to-gray-400 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">Base</span>
                        </button>
                        <button data-style="dataviz" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
                            <span class="w-5 h-5 rounded-md bg-gradient-to-br from-indigo-400 to-indigo-600 flex-shrink-0"></span>
                            <span class="text-gray-700 dark:text-slate-300">DataViz</span>
                        </button>
                        <button data-style="landscape" class="style-option w-full flex items-center gap-3 px-4 py-2 text-left text-sm hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-colors">
