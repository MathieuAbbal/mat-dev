                    </div>
                    <div class="ml-6">
                        <span class="text-[#a6e3a1]">company</span><span class="text-[#6c7086]">:</span> <span class="text-[#f38ba8]">"Nanogis"</span><span class="text-[#6c7086]">,</span>
                    </div>
                    <div class="ml-6">
                        <span class="text-[#a6e3a1]">stack</span><span class="text-[#6c7086]">:</span> <span class="text-[#89dceb]">[</span><span class="text-[#f38ba8]">"Angular"</span><span class="text-[#6c7086]">,</span> <span class="text-[#f38ba8]">"TypeScript"</span><span class="text-[#6c7086]">,</span> <span class="text-[#f38ba8]">"MapLibre"</span><span class="text-[#89dceb]">]</span><span class="text-[#6c7086]">,</span>
