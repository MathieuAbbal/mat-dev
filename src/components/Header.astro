<header
    class="sticky top-0 z-50 bg-white/60 dark:bg-slate-950/60 backdrop-blur-xl border-b border-gray-200/50 dark:border-slate-800/50 transition-all duration-300"
    id="main-header">
    <!-- Scroll progress bar -->
    <div id="scroll-progress" class="absolute top-0 left-0 h-0.5 bg-gradient-to-r from-indigo-500 to-cyan-500 transition-[width] duration-100" style="width:0%"></div>
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo -->
            <a href="#" class="flex items-center gap-2 group" aria-label="Accueil">
                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500 to-cyan-500 dark:from-[#7886fc] dark:to-[#65d9fd] flex items-center justify-center shadow-md shadow-indigo-500/20 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                    <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <span class="text-sm font-bold text-gray-900 dark:text-white tracking-tight hidden sm:inline">Mathieu<span class="text-indigo-600 dark:text-indigo-400">.dev</span></span>
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center space-x-1">
                <a href="#about" data-section="about"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    Profil
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>
                <a href="#services" data-section="services"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    Services
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>
                <a href="#skills" data-section="skills"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    Compétences
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>
                <a href="#experience" data-section="experience"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    Expérience
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>
                <a href="#projects" data-section="projects"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    Projets
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>
                <a href="#github" data-section="github"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    GitHub
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>
                <a href="#contact" data-section="contact"
                    class="nav-link px-4 py-2 text-gray-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors relative">
                    Contact
                    <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-indigo-600 dark:bg-indigo-400 rounded-full transition-all duration-300"></span>
                </a>

            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden flex items-center gap-3">
                <button id="navbar-toggle" aria-label="Menu de navigation" aria-expanded="false"
                    class="p-2 rounded-xl text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors">
                    <svg class="hamburger-icon w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg class="close-icon w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="navbar-collapse" class="hidden md:hidden pb-4 overflow-hidden transition-all duration-300">
            <div class="flex flex-col space-y-1 pt-2">
                <a href="#about"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">Profil</a>
                <a href="#services"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">Services</a>
                <a href="#skills"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">Compétences</a>
                <a href="#experience"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">Expérience</a>
                <a href="#projects"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">Projets</a>
                <a href="#github"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">GitHub</a>
                <a href="#contact"
                    class="px-4 py-3 text-gray-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl font-medium transition-all">Contact</a>
            </div>
        </div>
    </nav>
</header>

<script>
    // Mobile menu toggle
    const navbarToggle = document.getElementById('navbar-toggle');
    const navbarCollapse = document.getElementById('navbar-collapse');
    const hamburgerIcon = document.querySelector('.hamburger-icon');
    const closeIcon = document.querySelector('.close-icon');

    navbarToggle?.addEventListener('click', () => {
        navbarCollapse?.classList.toggle('hidden');
        hamburgerIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
    });


    // Active section indicator
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.id;
                navLinks.forEach(link => {
                    const indicator = link.querySelector('.nav-indicator') as HTMLElement;
                    if (link.getAttribute('data-section') === id) {
                        link.classList.add('text-indigo-600', 'dark:text-indigo-400');
                        if (indicator) indicator.style.width = '60%';
                    } else {
                        link.classList.remove('text-indigo-600', 'dark:text-indigo-400');
                        if (indicator) indicator.style.width = '0';
                    }
                });
            }
        });
    }, { rootMargin: '-20% 0px -70% 0px' });

    sections.forEach(section => observer.observe(section));

    // Header shadow + scroll progress
    const header = document.getElementById('main-header');
    const progress = document.getElementById('scroll-progress');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 10) {
            header?.classList.add('shadow-sm');
        } else {
            header?.classList.remove('shadow-sm');
        }
        if (progress) {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
            progress.style.width = `${pct}%`;
        }
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            if (href) {
                const target = document.querySelector(href);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    navbarCollapse?.classList.add('hidden');
                    hamburgerIcon?.classList.remove('hidden');
                    closeIcon?.classList.add('hidden');
                }
            }
        });
    });
</script>
